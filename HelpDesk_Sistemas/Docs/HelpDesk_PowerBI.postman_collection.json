{
  "info": {
    "name": "HelpDesk Sistemas - API Power BI",
    "description": "Endpoints de solo lectura para que Gerencia arme reportes en Power BI. Todos requieren el header X-Api-Key. Ver Docs/Conexion_PowerBI.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5102" },
    { "key": "apiKey", "value": "72cb0e18bdee44b585364aac6f1fb47f837af87aa687436b88cb3be900840461" }
  ],
  "item": [
    {
      "name": "Tickets - todos",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Api-Key", "value": "{{apiKey}}", "type": "text" }],
        "url": { "raw": "{{baseUrl}}/api/powerbi/tickets", "host": ["{{baseUrl}}"], "path": ["api", "powerbi", "tickets"] }
      }
    },
    {
      "name": "Tickets - filtrado por fecha",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Api-Key", "value": "{{apiKey}}", "type": "text" }],
        "url": {
          "raw": "{{baseUrl}}/api/powerbi/tickets?fechaInicio=2026-01-01&fechaFin=2026-12-31",
          "host": ["{{baseUrl}}"],
          "path": ["api", "powerbi", "tickets"],
          "query": [
            { "key": "fechaInicio", "value": "2026-01-01" },
            { "key": "fechaFin", "value": "2026-12-31" }
          ]
        }
      }
    },
    {
      "name": "Departamentos",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Api-Key", "value": "{{apiKey}}", "type": "text" }],
