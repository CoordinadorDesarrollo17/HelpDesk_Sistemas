@using HelpDesk_Sistemas.Models
@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<TicketsModel>

@functions {
    // Amarillo = el ticket está detenido esperando que alguien en concreto haga algo
    // (tomarlo, reanudarlo, validar la solución, confirmar las pruebas): al ver amarillo,
    // ese usuario sabe que le toca actuar. Mientras alguien ya lo está trabajando
    // activamente (En revisión, En atención, Levantamiento, Desarrollo, Pase a producción)
    // no hay una acción pendiente de un usuario puntual, así que se queda en azul/celeste.
    // Verde = cierre exitoso. "Anulado" no es ni espera ni cierre exitoso, así que mantiene
    // su propio color en vez de amarillo o verde.
    string EstadoBadgeClass(string? estado) => estado switch
    {
        "Cerrado" or "Cierre" => "bg-success",
        "Anulado" => "bg-dark",
        "Pendiente" or "En pausa" or "En validación" or "Pruebas" => "bg-warning text-dark",
        _ => "bg-info text-dark"
    };

    string PrioridadBadgeClass(string? prioridad) => prioridad switch
    {
        "Urgente" => "bg-danger",
        "Alta" => "bg-warning text-dark",
        "Media" => "bg-info text-dark",
        "Baja" => "bg-secondary",
        _ => "bg-light text-dark"
    };

    TicketSlaModel? SlaPrincipal(TicketsModel t) =>
        (t.SlaRespuesta != null && (t.SlaRespuesta.Etapa == "EnCurso" || t.SlaRespuesta.Etapa == "Pausado"))
            ? t.SlaRespuesta
            : t.SlaResolucion ?? t.SlaRespuesta;

    string SlaEtiqueta(TicketsModel t, TicketSlaModel sla) => sla == t.SlaRespuesta ? "Respuesta" : "Resolución";

    (string Css, string Texto) SlaBadge(TicketSlaModel? sla)
    {
        if (sla is null || sla.Etapa == "Cancelado") return ("bg-light text-dark", "-");
        if (sla.Incumplido == true) return ("bg-danger", "Incumplido");
        if (sla.Etapa == "Completado") return sla.CumplidoATiempo == true ? ("bg-success", "Cumplido") : ("bg-danger", "Incumplido");
        if (sla.Etapa == "Pausado") return ("bg-secondary", "Pausado");
        if (sla.AdvertenciaActiva == true) return ("bg-warning text-dark", $"{sla.PorcentajeConsumido:0}% - por vencer");
        return ("bg-info text-dark", $"{sla.PorcentajeConsumido:0}%");
    }
}

<div class="table-responsive">
    <table class="table table-hover align-middle text-nowrap">
        <thead class="table-header">
            <tr>
                <th>Código Ticket</th>
                <th>Sociedad</th>
                <th>Tipo de Atención</th>
                <th>Área de Soporte</th>
                <th>Categoría</th>
                <th>Estado</th>
                @if (ViewBag.Rol == "Administrador" || ViewBag.Rol == "Soporte")
                {
                    <th>Impacto</th>
                    <th>Prioridad</th>
                }
                @if (ViewBag.Rol == "Administrador" || ViewBag.Rol == "Soporte")
                {
                    <th>SLA</th>
                }
                @if (ViewBag.Rol == "Administrador" || ViewBag.Rol == "Soporte")
                {
                    <th>Orden</th>
                }
                <th>Solicitante</th>
                <th>Área Solicitante</th>
                <th>Personal Asignado</th>
                <th>Fecha Creación</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var u in Model)
            {
                // "esQuienReporto": el usuario logueado es quien creó el ticket. Confirmar o
                // devolver la solución le corresponde SIEMPRE a él, sin importar el área
                // (es quien sabe si su problema quedó resuelto).
                var esQuienReporto = u.Solicitante == ViewBag.Usuario;

                // "esSolicitante": además de haberlo creado, el ticket NO es para su propia
                // área de trabajo. En ese caso no debe operarlo (tomar/atender/pausar/anular):
                // esas acciones son de quien trabaja la cola. Excepción: si el ticket es para
                // su propia área (ej. un agente de Soporte TI reporta algo para Soporte TI),
                // sí puede accionarlo — no tiene sentido obligar a otro compañero a atenderlo.
                var esSolicitante = esQuienReporto && u.IdArea != (int)ViewBag.IdAreaUsuario;

                // "puedeOperar": solo quien tiene el ticket asignado —o nadie aún, cuando
                // sigue Pendiente— puede ejecutar acciones sobre él (tomar, atender, pausar,
                // validar, anular, y las etapas de Implementación/Mejora). Un coordinador o
                // administrador que ve el ticket de OTRO agente solo puede reasignarlo; hasta
                // que no quede reasignado a su nombre no puede ejecutar el resto de acciones.
                var esAsignadoActual = u.IdUsuarioAsignado == null || u.IdUsuarioAsignado == (int)ViewBag.IdUsuarioActual;
                var puedeOperar = !esSolicitante && esAsignadoActual;
                <tr class="@((u.Estado == "En validación" || u.Estado == "Pruebas") ? "fila-en-validacion" : (u.Estado == "Cerrado" || u.Estado == "Cierre") ? "fila-cerrado" : "")">
                    <td data-label="Código Ticket">@u?.CodigoTicket</td>
                    <td data-label="Sociedad">@(u?.Sociedad ?? "-")</td>
                    <td data-label="Tipo de Atención">@u?.TipoRequerimiento</td>
                    <td data-label="Área">@u?.Area</td>
                    <td data-label="Categoría">@u?.Categoria</td>
                    <td data-label="Estado"><span class="badge @EstadoBadgeClass(u.Estado)">@u?.Estado</span></td>

                    <td data-label="Impacto">
                        @{
                            // El impacto lo reporta quien crea el ticket, pero puede no ser el
                            // correcto — Soporte/Administrador lo corrige antes de tomarlo (mismo
                            // criterio que la prioridad). Solo aplica a tickets que usan la matriz
                            // Impacto × Urgencia (u.IdImpacto tiene valor); Implementación/Mejora no.
                            var puedeCorregirImpacto = (ViewBag.Rol == "Administrador" || ViewBag.Rol == "Soporte") && !esSolicitante && u.IdImpacto.HasValue;
                        }
                        @if (puedeCorregirImpacto && u.Estado == "Pendiente")
                        {
                            <select class="form-select form-select-sm" onchange="corregirImpacto(@u.IdTicket, this.value)">
                                @foreach (var impacto in (List<CatalogoModel>)ViewBag.Impactos)
                                {
                                    <option value="@impacto.Id" selected="@(u.Impacto == impacto.Nombre)">@impacto.Nombre</option>
                                }
                            </select>
                        }
                        else if (u.Impacto != null)
                        {
                            @u.Impacto
                        }
                        else
                        {
                            @:-
                        }
                    </td>

                    <td data-label="Prioridad">
                        @{
                            // Misma regla que el orden de atención: la prioridad la define quien
                            // trabaja la cola, nunca el solicitante. Para él siempre es de solo
                            // lectura: "-" hasta que Soporte la defina, y luego el valor puesto.
                            var puedeEditarPrioridad = (ViewBag.Rol == "Administrador" || ViewBag.Rol == "Soporte") && !esSolicitante;
                        }
                        @if (puedeEditarPrioridad && u.Estado == "Pendiente")
                        {
                            <select class="form-select form-select-sm" onchange="asignarPrioridad(@u.IdTicket, this.value)">
                                <option value="">Sin definir</option>
                                @foreach (var prioridad in (List<CatalogoModel>)ViewBag.Prioridades)
                                {
                                    <option value="@prioridad.Id" selected="@(u.Prioridad == prioridad.Nombre)">@prioridad.Nombre</option>
                                }
                            </select>
                        }
                        else if (u.Prioridad != null)
                        {
                            <span class="badge @PrioridadBadgeClass(u.Prioridad)">@u.Prioridad</span>
                        }
                        else
                        {
                            @:-
                        }
                    </td>

                    <td data-label="SLA">
                        @{
                            var slaPrincipal = SlaPrincipal(u);
                            var slaBadge = SlaBadge(slaPrincipal);
                        }
                        @if (slaPrincipal is null)
                        {
                            @:-
                        }
                        else
                        {
                            <span class="badge @slaBadge.Css" title="@SlaEtiqueta(u, slaPrincipal) &#183; vence @slaPrincipal.FechaObjetivo?.ToString("dd/MM HH:mm")">
                                @SlaEtiqueta(u, slaPrincipal): @slaBadge.Texto
                            </span>
                        }
                    </td>

                    <td data-label="Orden">
                        @{
                            var estadosNoEditablesOrden = new[] { "En atención", "Desarrollo", "Pruebas", "Pase a producción", "Cierre", "Cerrado", "Anulado" };
                            // El orden de atención lo define quien trabaja la cola (Soporte/Administrador),
                            // nunca quien solicitó el ticket — para el solicitante siempre es de solo lectura:
                            // "-" hasta que Soporte lo tome y le asigne un orden, y luego el valor que haya puesto.
                            var puedeEditarOrden = (ViewBag.Rol == "Administrador" || ViewBag.Rol == "Soporte") && !esSolicitante;
                        }
                        @if (puedeEditarOrden && !estadosNoEditablesOrden.Contains(u.Estado) && u.CantidadMismaAsignadoPrioridad > 1)
                        {
                            <input type="number"
                                   min="1"
                                   class="form-control form-control-sm"
                                   style="width: 70px;"
                                   value="@u.OrdenAtencion"
                                   onchange="asignarOrdenAtencion(@u.IdTicket, this.value)" />
                        }
                        else
                        {
                            @(u.OrdenAtencion?.ToString() ?? "-")
                        }
                    </td>

                    <td data-label="Solicitante">@u?.Solicitante</td>
                    <td data-label="Área Solicitante">
                        @{
                            // Temporal, solo para pruebas (ver CrearTicketModel.IdAreaSolicitante):
                            // deja corregir a mano de qué área es el solicitante, ya que mientras
                            // se prueba con las mismas cuentas siempre sale la misma área real.
                            var puedeCorregirAreaSolicitante = ViewBag.Rol == "Administrador" || ViewBag.Rol == "Soporte";
                        }
                        @if (puedeCorregirAreaSolicitante)
                        {
                            <select class="form-select form-select-sm" onchange="corregirAreaSolicitante(@u.IdTicket, this.value)">
                                <option value="">Usar la real</option>
                                @foreach (var areaSol in (List<CatalogoModel>)ViewBag.AreasSolicitantes)
                                {
                                    <option value="@areaSol.Id" selected="@(u.AreaSolicitante == areaSol.Nombre)">@areaSol.Nombre</option>
                                }
                            </select>
                        }
                        else
                        {
                            @(u?.AreaSolicitante ?? "-")
                        }
                    </td>
                    <td data-label="Personal Asignado">@u?.Asignado</td>
                    <td data-label="Fecha Creación">@u?.FechaCreacion.ToString("dd/MM/yyyy")</td>

                    <td data-label="Acciones" class="text-center">
                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Ver detalle" onclick="verDetalle(@u.IdTicket)">
                            <i class="bi bi-eye"></i>
                        </button>

                        @if (u.Estado == "Pendiente" && u.Flujo == "Soporte" && (ViewBag.Rol == "Administrador" || ViewBag.Rol == "Soporte") && puedeOperar)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary" title="Tomar ticket" onclick="tomarTicket(@u.IdTicket)">
                                <i class="bi bi-hand-index"></i>
                            </button>
                        }

                        @if (u.Estado == "En revisión" && puedeOperar)
                        {
                            <button type="button" class="btn btn-sm btn-outline-info" title="Atender Ticket" onclick="atenderTicket(@u.IdTicket)">
                                <i class="bi bi-person-workspace"></i>
                            </button>
                        }

                        @if ((u.Estado == "En atención" || u.Estado == "Desarrollo") && puedeOperar)
                        {
                            <button type="button" class="btn btn-sm btn-outline-warning" title="Pausar ticket" onclick="abrirPausarTicket(@u.IdTicket)">
                                <i class="bi bi-pause-circle"></i>
                            </button>
                        }
                        else if (u.Estado == "En pausa" && puedeOperar)
                        {
                            <button type="button" class="btn btn-sm btn-outline-success" title="Reanudar ticket" onclick="reanudarTicket(@u.IdTicket)">
                                <i class="bi bi-play-circle"></i>
                            </button>
                        }

                        @if (u.Estado == "En atención" && puedeOperar)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary" title="Validar / registrar solución" onclick="abrirValidarTicket(@u.IdTicket, @(u.IdGuiaCategoria?.ToString() ?? "null"))">
                                <i class="bi bi-check2-square"></i>
                            </button>
                        }

                        @if (u.Estado == "En validación" && esQuienReporto)
                        {
                            <button type="button" class="btn btn-sm btn-outline-success" title="Ver solución y confirmar" onclick="abrirConfirmarSolucion(@u.IdTicket)">
                                <i class="bi bi-check-circle"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-warning" title="Devolver ticket" onclick="abrirDevolverTicket(@u.IdTicket)">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </button>
                        }

                        <!-- IMPLEMENTACIÓN Y MEJORA -->
                        @if (u.Estado == "Pendiente" && u.Flujo == "ImplementacionMejora" && puedeOperar)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary" title="Tomar para levantamiento" onclick="tomarLevantamiento(@u.IdTicket)">
                                <i class="bi bi-clipboard-check"></i>
                            </button>
                        }

                        @if (u.Estado == "Levantamiento" && puedeOperar)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary" title="Iniciar desarrollo" onclick="iniciarDesarrollo(@u.IdTicket)">
                                <i class="bi bi-code-slash"></i>
                            </button>
                        }

                        @if (u.Estado == "Desarrollo" && puedeOperar)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary" title="Enviar a pruebas" onclick="enviarAPruebas(@u.IdTicket)">
                                <i class="bi bi-clipboard-data"></i>
                            </button>
                        }

                        @* Igual que "En validación" en Soporte: en Pruebas quien trabaja es el
                           solicitante probando, no el desarrollador — por eso confirmar/devolver es
                           exclusivo de esQuienReporto, sin importar el área (antes "!esSolicitante"
                           dejaba afuera justo a quien reportó el ticket cuando era de otra área). *@
                        @if (u.Estado == "Pruebas" && esQuienReporto)
                        {
                            <button type="button" class="btn btn-sm btn-outline-success" title="Confirmar pruebas OK" onclick="abrirConfirmarPruebas(@u.IdTicket, '@u.CodigoTicket')">
                                <i class="bi bi-check2-all"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-warning" title="Devolver con feedback" onclick="abrirDevolverPruebas(@u.IdTicket)">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </button>
                        }

                        @if (u.Estado == "Pase a producción" && puedeOperar)
                        {
                            <button type="button" class="btn btn-sm btn-outline-success" title="Cerrar ticket" onclick="cerrarImplementacion(@u.IdTicket)">
                                <i class="bi bi-flag"></i>
                            </button>
                        }

                        <!-- REASIGNAR -->
                        @{
                            var estadosNoReasignables = new[] { "Cerrado", "Anulado", "Cierre" };
                        }
                        @if (u.Asignado != null && !estadosNoReasignables.Contains(u.Estado) && (ViewBag.Rol == "Administrador" || (ViewBag.Rol == "Soporte" && ViewBag.EsCoordinador)) && !esSolicitante)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" title="Reasignar" onclick="abrirReasignarTicket(@u.IdTicket, @u.IdArea)">
                                <i class="bi bi-people"></i>
                            </button>
                        }

                        <!-- ANULAR -->
                        @{
                            var estadosAnulables = new[] {
                                        "Pendiente", "En revisión", "En atención", "En pausa", "En validación",
                                        "Levantamiento", "Desarrollo", "Pruebas", "Pase a producción"
                                        };
                        }
                        @if (estadosAnulables.Contains(u.Estado) && puedeOperar)
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger" title="Anular ticket" onclick="abrirAnularTicket(@u.IdTicket)">
                                <i class="bi bi-x-circle"></i>
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-center mt-2 gap-2">
    <small class="text-muted text-center text-md-start text-md-nowrap flex-shrink-0">
        Mostrando @Model.FirstItemOnPage a @Model.LastItemOnPage de @Model.TotalItemCount registros
    </small>

    <div class="w-100 w-md-auto paginacion">
        @Html.PagedListPager(Model, page => "javascript:cargarTabla(" + page + ")",
        new PagedListRenderOptions
        {
            LiElementClasses = new[] { "page-item" },
            PageClasses = new[] { "page-link" },
            UlElementClasses = new[] { "pagination", "mb-0" },
            DisplayLinkToFirstPage = PagedListDisplayMode.Always,
            DisplayLinkToLastPage = PagedListDisplayMode.Always,
            DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
            DisplayLinkToNextPage = PagedListDisplayMode.Always,
            MaximumPageNumbersToDisplay = 5
        })
    </div>
</div>