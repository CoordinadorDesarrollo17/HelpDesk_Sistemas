@using HelpDesk_Sistemas.Models
@model TicketDetalleModel

@functions {
    (string Css, string Texto) SlaBadge(TicketSlaModel sla)
    {
        if (sla.Etapa == "Cancelado") return ("bg-light text-dark", "Cancelado");
        if (sla.Incumplido == true) return ("bg-danger", "Incumplido");
        if (sla.Etapa == "Completado") return sla.CumplidoATiempo == true ? ("bg-success", "Cumplido") : ("bg-danger", "Incumplido");
        if (sla.Etapa == "Pausado") return ("bg-secondary", "Pausado");
        if (sla.AdvertenciaActiva == true) return ("bg-warning text-dark", "Por vencer");
        return ("bg-info text-dark", "En curso");
    }
}

<div class="mb-3">
    <h5 class="fw-bold">@Model.CodigoTicket</h5>
</div>

<dl class="row">
    <dt class="col-sm-4">Sociedad</dt>
    <dd class="col-sm-8">@(Model.Sociedad ?? "-")</dd>

    <dt class="col-sm-4">Tipo de requerimiento</dt>
    <dd class="col-sm-8">@Model.TipoRequerimiento</dd>

    <dt class="col-sm-4">Área</dt>
    <dd class="col-sm-8">@Model.Area</dd>

    <dt class="col-sm-4">Categoría</dt>
    <dd class="col-sm-8">@(Model.Categoria ?? "-")</dd>

    @if (Model.Impacto != null || Model.Urgencia != null)
    {
        <dt class="col-sm-4">Impacto</dt>
        <dd class="col-sm-8">@(Model.Impacto ?? "-")</dd>

        <dt class="col-sm-4">Urgencia</dt>
        <dd class="col-sm-8">@(Model.Urgencia ?? "-")</dd>
    }
    else if (Model.AfectaFuncionamiento.HasValue)
    {
        <dt class="col-sm-4">¿Detiene procesos?</dt>
        <dd class="col-sm-8">@(Model.AfectaFuncionamiento.Value ? "Sí" : "No")</dd>
    }

    @if (Model.Prioridad != null)
    {
        <dt class="col-sm-4">Prioridad</dt>
        <dd class="col-sm-8">@Model.Prioridad</dd>
    }
</dl>

@if (Model.SlaRespuesta != null || Model.SlaResolucion != null)
{
    <hr />
    <h6 class="fw-bold">SLA</h6>

    @foreach (var (etiqueta, sla) in new[] { ("Respuesta", Model.SlaRespuesta), ("Resolución", Model.SlaResolucion) })
    {
        if (sla is null) continue;

        var badge = SlaBadge(sla);
        var porcentaje = Math.Clamp((double)(sla.PorcentajeConsumido ?? 0), 0, 100);

        <div class="mb-2">
            <div class="d-flex justify-content-between align-items-center">
                <span>
                    <strong>@etiqueta</strong>
                    <span class="badge @badge.Css ms-1">@badge.Texto</span>
                </span>
                <small class="text-muted">
                    @if (sla.FechaFin.HasValue)
                    {
                        @:Cerrado @sla.FechaFin.Value.ToString("dd/MM/yyyy HH:mm")
                    }
                    else
                    {
                        @:Vence @sla.FechaObjetivo?.ToString("dd/MM/yyyy HH:mm")
                    }
                </small>
            </div>
            <div class="progress mt-1" style="height: 6px;">
                <div class="progress-bar @(sla.Incumplido == true ? "bg-danger" : sla.AdvertenciaActiva == true ? "bg-warning" : "bg-info")"
                     style="width: @(porcentaje)%;"></div>
            </div>
        </div>
    }
}

<hr />

<h6 class="fw-bold">Detalle del requerimiento</h6>
<p>@Model.Detalle</p>

<hr />

<h6 class="fw-bold">Archivos adjuntos</h6>
@if (Model.Adjuntos.Count == 0)
{
    <p class="text-muted">Este ticket no tiene archivos adjuntos.</p>
}
else
{
    <ul class="list-group">
        @foreach (var adj in Model.Adjuntos)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <a href="@adj.RutaArchivo" target="_blank" rel="noopener">@adj.NombreArchivo</a>
                @if (adj.PesoKB.HasValue)
                {
                    <small class="text-muted">@adj.PesoKB KB</small>
                }
            </li>
        }
    </ul>
}

<hr />

<h6 class="fw-bold">Bitácora</h6>
<ul class="list-group">
    @foreach (var h in Model.Historial)
    {
        <li class="list-group-item">
            <div class="d-flex justify-content-between">
                <span>
                    @if (h.EstadoAnterior != null && h.EstadoAnterior != h.EstadoNuevo)
                    {
                        <strong>@h.EstadoAnterior</strong> <text>→</text> <strong>@h.EstadoNuevo</strong>
                    }
                    else if (h.EstadoAnterior == h.EstadoNuevo)
                    {
                        <strong>@h.EstadoNuevo</strong> <span class="text-muted">(sin cambio de estado)</span>
                    }
                    else
                    {
                        <strong>Creación</strong> <text>→</text> <strong>@h.EstadoNuevo</strong>
                    }
                </span>
                <small class="text-muted">@h.FechaCambio.ToString("dd/MM/yyyy HH:mm")</small>
            </div>
            <small class="text-muted">Por: @h.UsuarioAccion</small>
            @if (!string.IsNullOrWhiteSpace(h.Comentario))
            {
                <div><em>@h.Comentario</em></div>
            }
        </li>
    }
</ul>