		function mostrarToast(mensaje, tipo = "danger"){
			const toastEl = document.getElementById("toastGenerico");
			const toastMensaje = document.getElementById("toastMensaje");

			toastEl.classList.remove("text-bg-success", "text-bg-danger", "text-bg-warning");
			toastEl.classList.add(`text-bg-${tipo}`);

			toastMensaje.textContent = mensaje;

			const toast = new bootstrap.Toast(toastEl, {delay: 4000});
			toast.show();
		}

		function inicializarValidacionArchivos() {
			const inputArchivos = document.querySelector('input[name="Archivos"]');
			const extensionesPermitidas = ['.jpg', '.jpeg', '.png', '.pdf', '.xlsx', '.docx', '.mp4'];
			const tamanoMaximoBytes = 10 * 1024 * 1024;
			const btnSubmit = document.querySelector('#formCrearTicket button[type="submit"]');

			inputArchivos.addEventListener("change", function () {
				const errores = [];

				for (const archivo of this.files) {
					const extension = "." + archivo.name.split(".").pop().toLowerCase();

					if (!extensionesPermitidas.includes(extension)) {
						errores.push(`"${archivo.name}" tiene un formato no permitido.`);
					}

					if (archivo.size > tamanoMaximoBytes) {
						errores.push(`"${archivo.name}" supera el tamaño máximo de 10 MB.`);
					}
				}

				const spanError = document.querySelector('span[data-valmsg-for="Archivos"]');

				if (errores.length > 0) {
					spanError.textContent = errores.join(" ") + " Vuelve a seleccionar los archivos para continuar.";
					btnSubmit.disabled = true;
				} else {
					spanError.textContent = "";
					btnSubmit.disabled = false;
				}
			});
		}

		//REASIGNARUSUARIO
		function abrirReasignarTicket(idTicket, idArea) {
			document.getElementById("idTicketReasignar").value = idTicket;
			document.getElementById("idAreaReasignar").value = idArea;
			document.getElementById("errorReasignarTicket").textContent = "";

			const cboNuevoUsuario = document.getElementById("cboNuevoUsuario");
			cboNuevoUsuario.innerHTML = '<option value="">Cargando...</option>';

			const modal = new bootstrap.Modal(document.getElementById("modalReasignarTicket"));
			modal.show();

			fetch(`@Url.Action("UsuariosSoportePorArea")?idArea=${idArea}`)
				.then(r => r.json())
				.then(data => {
					cboNuevoUsuario.innerHTML = '<option value="">Selecciona...</option>';
					data.forEach(u => {
						const opt = document.createElement("option");
						opt.value = u.id;
						opt.textContent = u.nombre;
						cboNuevoUsuario.appendChild(opt);
					});
				});
		}

		function confirmarReasignarTicket() {
			const idTicket = document.getElementById("idTicketReasignar").value;
			const idNuevoUsuario = document.getElementById("cboNuevoUsuario").value;

			if (!idNuevoUsuario) {
				document.getElementById("errorReasignarTicket").textContent = "Selecciona a quién reasignar el ticket.";
				return;
			}

			const params = new URLSearchParams({ id: idTicket, idNuevoUsuario: idNuevoUsuario });

			fetch(`@Url.Action("ReasignarTicket")?${params.toString()}`, { method: "POST" })
				.then(r => r.json())
				.then(data => {
					if (data.exito) {
						bootstrap.Modal.getInstance(document.getElementById("modalReasignarTicket")).hide();
						mostrarToast("Ticket reasignado correctamente", "success");
						cargarTabla(1);
					} else {
						document.getElementById("errorReasignarTicket").textContent = data.mensaje;
					}
				});
		}
