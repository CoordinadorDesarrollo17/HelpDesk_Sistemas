			const params = new URLSearchParams({ id: idTicket, tipoMotivo: tipoMotivo });
			if (idTicketRelacionado) {
				params.append("idTicketRelacionado", idTicketRelacionado);
			}

			fetchConManejo(`@Url.Action("PausarTicket")?${params.toString()}`, { method: "POST" })
				.then(r => {
					if (!r) return;
					return r.json();
				})
