		function actualizarVisibilidadPorTipo() {
			const cboTipo = document.getElementById("cboTipoRequerimiento");
			const opcionSeleccionada = cboTipo.options[cboTipo.selectedIndex];
			const requiereCategoria = opcionSeleccionada.dataset.requiereCategoria === "true";

			const grupoCategoria = document.getElementById("grupoCategoria");
			const grupoImpactoUrgencia = document.getElementById("grupoImpactoUrgencia");

			grupoCategoria.style.display = requiereCategoria ? "block" : "none";
			grupoImpactoUrgencia.style.display = requiereCategoria ? "block" : "none";

			if (!requiereCategoria) {
				document.getElementById("cboCategoria").value = "";
				document.querySelector('select[name="IdImpacto"]').value = "";
				document.querySelector('select[name="IdUrgencia"]').value = "";
			}

			actualizarPrioridadEstimada();
		}

