		// Antes de confirmar se muestra la solución que registró Soporte: así el
		// solicitante decide con la información a la vista, no a ciegas.
		function abrirConfirmarSolucion(idTicket) {
			document.getElementById("idTicketConfirmar").value = idTicket;
			document.getElementById("codigoTicketSolucion").textContent = "";
			document.getElementById("metaSolucion").textContent = "";
			document.getElementById("textoSolucion").textContent = "Cargando...";

			const modal = new bootstrap.Modal(document.getElementById("modalConfirmarSolucion"));
			modal.show();

			fetchConManejo(`@Url.Action("ObtenerSolucion")?id=${idTicket}`)
				.then(r => {
					if (!r) return null;
					if (!r.ok) {
						document.getElementById("textoSolucion").textContent = "No se pudo cargar la solución.";
						return null;
					}
					return r.json();
				})
				.then(data => {
					if (!data) return;

					document.getElementById("codigoTicketSolucion").textContent = data.codigoTicket || "";

					const partes = [];
					if (data.resueltoPor) partes.push(`Resuelto por ${data.resueltoPor}`);
					if (data.fechaSolucion) partes.push(data.fechaSolucion);
					document.getElementById("metaSolucion").textContent = partes.join(" · ");

					// textContent (no innerHTML): la solución es texto escrito por un usuario.
					document.getElementById("textoSolucion").textContent =
						data.solucion && data.solucion.trim()
							? data.solucion
							: "Soporte no registró un detalle de la solución.";
				});
		}

