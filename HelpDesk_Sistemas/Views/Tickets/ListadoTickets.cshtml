		function inicializarPrioridadEstimada() {
			document.getElementById("cboImpacto").addEventListener("change", actualizarPrioridadEstimada);
			document.getElementById("cboUrgencia").addEventListener("change", actualizarPrioridadEstimada);
			actualizarPrioridadEstimada();
		}

		function actualizarPrioridadEstimada() {
			const contenedor = document.getElementById("prioridadEstimada");
			const idTipo = parseInt(document.getElementById("cboTipoRequerimiento").value);
			const idImpacto = parseInt(document.getElementById("cboImpacto").value);
			const idUrgencia = parseInt(document.getElementById("cboUrgencia").value);

			if (!idTipo || !idImpacto || !idUrgencia) {
				contenedor.innerHTML = "";
				return;
			}

			const matriz = JSON.parse(document.getElementById("grupoImpactoUrgencia").dataset.matriz);
			const fila = matriz.find(m => m.idTipoReq === idTipo && m.idImpacto === idImpacto && m.idUrgencia === idUrgencia);

			if (!fila) {
				contenedor.innerHTML = "";
				return;
			}

			const clasesPorPrioridad = { "Baja": "bg-secondary", "Media": "bg-info text-dark", "Alta": "bg-warning text-dark", "Urgente": "bg-danger" };
			const clase = clasesPorPrioridad[fila.prioridad] || "bg-secondary";

			contenedor.innerHTML = `Prioridad estimada: <span class="badge ${clase}">${fila.prioridad}</span>`;
		}

