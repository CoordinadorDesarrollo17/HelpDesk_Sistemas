@using HelpDesk_Sistemas.Models
@using X.PagedList
@model IPagedList<TicketsModel>


@{
	ViewData["Title"] = "Listado Tickets";
}

@section Styles {
	<style>
		
	</style>
}


<div class="card shadow-sm mb-4">
	<div class="card-header header-gradient text-black d-flex justify-content-between align-items-center">
		<h5 class="mb-0 fw-bold">LISTADO DE TICKETS</h5>

		<!--BOTON CREAR TICKET-->
		<button type="button" class="btn btn-primary btn-sm" onclick="abrirCrearTicket()">
			<i class="bi bi-plus-lg"></i> Nuevo ticket
		</button>
	</div>

	<div class="card-body">

		<div class="row mb-3 gy-2">

			<!--PAGINACION-->
			<div class="col-12 col-md-6">
				<div class="d-flex align-items-center gap-2 flex-wrap">
					<label class="mb-0 fw-semibold">Mostrar</label>

					<select id="pageSize" class="form-select form-select-sm w-auto">
						@foreach (var size in new[] { 1, 5, 10, 20, 40, 60, 80, 100 })
						{
							<option value="@size" selected="@(size == 10)">@size</option>
						}
					</select>

					<span class="text-nowrap">registros por página</span>
				</div>
			</div>

			<!--BUSCADOR Y GENERAR EXCEL-->
			<div class="col-12 col-md-6">
				<div class="d-flex justify-content-start justify-content-md-end gap-2">
					<input type="text"
						   id="txtBuscar"
						   class="form-control form-control-sm w-100 w-md-auto"
						   style="max-width: 300px;"
						   placeholder="Buscar:" autocomplete="off" />

					<button id="btnExportarExcel" class="btn btn-success btn-sm">
						<i class="bi bi-file-earmark-excel"></i>
					</button>
				</div>
			</div>

		</div>

		<!--FILTROS PARA ESTADOS, AREAS, TIPO REQUERIMIENTO, PRIORIDADES-->
		<div class="col-12">
			<div class="d-flex flex-wrap gap-2">
				<select id="filtroEstado" class="form-select form-select-sm w-auto">
					<option value="">Todos los estados</option>
					@foreach (var estado in (List<CatalogoModel>)ViewBag.Estados)
					{
						<option value="@estado.Id">@estado.Nombre</option>
					}
				</select>

				<select id="filtroArea" class="form-select form-select-sm w-auto">
					<option value="">Todas las áreas</option>
					@foreach (var area in (List<CatalogoModel>)ViewBag.Areas)
					{
						<option value="@area.Id">@area.Nombre</option>
					}
				</select>

				<select id="filtroTipo" class="form-select form-select-sm w-auto">
					<option value="">Todos los tipos</option>
					@foreach (var tipo in (List<TipoRequerimientoModel>)ViewBag.Tipos)
					{
						<option value="@tipo.Id">@tipo.Nombre</option>
					}
				</select>

				<select id="filtroPrioridad" class="form-select form-select-sm w-auto">
					<option value="">Todas las prioridades</option>
					@foreach (var prioridad in (List<CatalogoModel>)ViewBag.Prioridades)
					{
						<option value="@prioridad.Id">@prioridad.Nombre</option>
					}
				</select>
			</div>
		</div>

		<div id="tablaTickets">
			<partial name="_TablaListaTickets" model="Model" />
		</div>

		<!--MODAL VER DETALLES DEL TICKET-->
		<div class="modal fade" id="modalDetalleTicket" tabindex="-1">
			<div class="modal-dialog modal-dialog-scrollable modal-lg">
				<div class="modal-content">
					<div class="modal-header">
						<h5 class="modal-title">Detalle del ticket</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
					</div>
					<div class="modal-body" id="contenidoDetalleTicket">
					</div>
				</div>
			</div>
		</div>

		<!--MODAL CREAR TICKET-->
		<div class="modal fade" id="modalCrearTicket" tabindex="-1">
			<div class="modal-dialog modal-lg">
				<div class="modal-content">
					<div class="modal-header">
						<h5 class="modal-title">Nuevo ticket</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
					</div>
					<div class="modal-body" id="contenidoCrearTicket">
					</div>
				</div>
			</div>
		</div>

		<!--MODAL ANULAR TICKET-->
		<div class="modal fade" id="modalAnularTicket" tabindex="-1">
			<div class="modal-dialog modal-lg">
				<div class="modal-content">
					<div class="modal-header">
						<h5 class="modal-title">Anular Ticket</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
					</div>
					<div class="modal-body">
						<input type="hidden" id="idTicketAnular"/>
						<label class="form-label">Motivo de Anulación</label>
						<textarea id="motivoAnulacion" class="form-control" rows="3"></textarea>
						<span id="errorMotivoAnulacion" class="text-danger small"></span>
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
						<button type="button" class="btn btn-danger" onclick="confirmarAnularTicket()">Anular ticket</button>
					</div>
				</div>
			</div>
		</div>

		<!--MODAL PAUSAR TICKET-->
		<div class="modal fade" id="modalPausarTicket" tabindex="-1">
			<div class="modal-dialog">
				<div class="modal-content">
					<div class="modal-header">
						<h5 class="modal-title">Pausar ticket</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
					</div>
					<div class="modal-body">
						<input type="hidden" id="idTicketPausar" />

						<div class="mb-3">
							<label class="form-label d-block">Motivo de la pausa</label>

							<div class="form-check">
								<input class="form-check-input" type="radio" name="tipoMotivoPausa" id="motivoReunion" value="Reunion" checked>
								<label class="form-check-label" for="motivoReunion">Por reunión</label>
							</div>

							<div class="form-check">
								<input class="form-check-input" type="radio" name="tipoMotivoPausa" id="motivoOtroTicket" value="AtencionOtroTicket">
								<label class="form-check-label" for="motivoOtroTicket">Por atención de otro ticket</label>
							</div>
						</div>

						<div class="mb-3" id="contenedorOtroTicket" style="display: none;">
							<label class="form-label">¿Qué ticket vas a atender?</label>
							<select id="cboTicketRelacionado" class="form-select">
								<option value="">Selecciona...</option>
							</select>
						</div>

						<span id="errorPausarTicket" class="text-danger small"></span>
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
						<button type="button" class="btn btn-warning" onclick="confirmarPausarTicket()">Pausar ticket</button>
					</div>
				</div>
			</div>
		</div>

		<!-- MODAL VALIDAR TICKET-->
		<div class="modal fade" id="modalValidarTicket" tabindex="-1">
			<div class="modal-dialog">
				<div class="modal-content">
					<div class="modal-header">
						<h5 class="modal-title">Registrar solución</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
					</div>
					<div class="modal-body">
						<input type="hidden" id="idTicketValidar" />
						<label class="form-label">Solución / explicación</label>
						<textarea id="solucionTicket" class="form-control" rows="4"></textarea>
						<span id="errorValidarTicket" class="text-danger small"></span>
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
						<button type="button" class="btn btn-primary" onclick="confirmarValidarTicket()">Enviar a validación</button>
					</div>
				</div>
			</div>
		</div>

		<!--MODAL DEVOLVER TICKET -->
		<div class="modal fade" id="modalDevolverTicket" tabindex="-1">
			<div class="modal-dialog">
				<div class="modal-content">
					<div class="modal-header">
						<h5 class="modal-title">Devolver ticket</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
					</div>
					<div class="modal-body">
						<input type="hidden" id="idTicketDevolver" />
						<label class="form-label">¿Por qué devuelves este ticket?</label>
						<textarea id="motivoDevolucion" class="form-control" rows="4"></textarea>
						<span id="errorDevolverTicket" class="text-danger small"></span>
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
						<button type="button" class="btn btn-danger" onclick="confirmarDevolverTicket()">Devolver</button>
					</div>
				</div>
			</div>
		</div>

		<!--MODAL PARA REASIGNAR TICKET-->
		<div class="modal fade" id="modalReasignarTicket" tabindex="-1">
			<div class="modal-dialog">
				<div class="modal-content">
					<div class="modal-header">
						<h5 class="modal-title">Reasignar ticket</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
					</div>
					<div class="modal-body">
						<input type="hidden" id="idTicketReasignar" />
						<input type="hidden" id="idAreaReasignar" />

						<label class="form-label">Nuevo responsable</label>
						<select id="cboNuevoUsuario" class="form-select">
							<option value="">Cargando...</option>
						</select>
						<span id="errorReasignarTicket" class="text-danger small"></span>
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
						<button type="button" class="btn btn-primary" onclick="confirmarReasignarTicket()">Reasignar</button>
					</div>
				</div>
			</div>
		</div>

		<!--TOAST PARA REEMPLAZAR LOS ALERT DEL NAVEGADOR-->
		<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
			<div id="toastGenerico" class="toast align-items-center border-0" role="alert">
				<div class="d-flex">
					<div class="toast-body" id="toastMensaje"></div>
					<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
				</div>
			</div>
		</div>
	</div>
</div>


@section Scripts {
	<script>
		const txtBuscar = document.getElementById("txtBuscar");
		const cboPageSize = document.getElementById("pageSize");
		const tablaTickets = document.getElementById("tablaTickets");

		function cargarTabla(page = 1) {
			const params = new URLSearchParams({
				"Buscar": txtBuscar.value,
				"IdEstado": document.getElementById("filtroEstado").value,
				"IdArea": document.getElementById("filtroArea").value,
				"IdTipoRequerimiento": document.getElementById("filtroTipo").value,
				"IdPrioridad": document.getElementById("filtroPrioridad").value,
				"Paginacion.Page": page,
				"Paginacion.PageSize": cboPageSize.value
			});

			let url = `@Url.Action("ListadoTickets", "Tickets")?${params.toString()}`;

			fetch(url, {
				headers: { "X-Requested-With": "XMLHttpRequest" }
			})
			.then(r => r.text())
			.then(html => {
				tablaTickets.innerHTML = html;
			});
		}

		["filtroEstado", "filtroArea", "filtroTipo", "filtroPrioridad"].forEach(id => {
			document.getElementById(id).addEventListener("change", () => cargarTabla(1));
		});

		//lanzamos eventos de los <select>
		cboPageSize.addEventListener("change", () => cargarTabla(1));

		//Agregamos evento para que el usuario de enter
		agregarEventosBusqueda(txtBuscar);

		  //funcion para agregar evento enter
		function agregarEventosBusqueda(input) {
			if (!input) return;

			// Cuando presiona Enter
			input.addEventListener("keydown", function (e) {
				if (e.key === "Enter") {
					e.preventDefault();
					cargarTabla(1);
				}
			});

			// Cuando borra todo el contenido
			input.addEventListener("input", function () {
				if (input.value.trim() === "") {
					cargarTabla(1);
				}
			});
		}

		document.getElementById("btnExportarExcel").addEventListener("click", function () {
			const query = txtBuscar.value;
			const url = `@Url.Action("ExportarExcel", "Tickets")?Buscar=${encodeURIComponent(query)}`;
			window.location.href = url;
		});

		function verDetalle(idTicket) {
			const modalEl = document.getElementById("modalDetalleTicket");
			const modal = new bootstrap.Modal(modalEl);
			const contenido = document.getElementById("contenidoDetalleTicket");

			contenido.innerHTML = "Cargando...";
			modal.show();

			fetch(`@Url.Action("VerDetalle")?id=${idTicket}`)
				.then(r => r.text())
				.then(html => {
					contenido.innerHTML = html;
				});
		}

		function abrirCrearTicket() {
			const modalEl = document.getElementById("modalCrearTicket");
			const modal = new bootstrap.Modal(modalEl);
			const contenido = document.getElementById("contenidoCrearTicket");

			contenido.innerHTML = "Cargando...";
			modal.show();

			fetch(`@Url.Action("CrearTicket")`)
				.then(r => r.text())
				.then(html => {
					contenido.innerHTML = html;
					inicializarValidacionArchivos();
					inicializarComboCategoria();
					inicializarComboTipoRequerimiento();
					inicializarFormularioCrearTicket();
				});
		}

		function inicializarFormularioCrearTicket() {
			const form = document.getElementById("formCrearTicket");

			form.addEventListener("submit", function (e) {
				e.preventDefault();

				const formData = new FormData(form);

				fetch(form.action, {
					method: "POST",
					body: formData
				})
				.then(r => {
					if (r.ok) {
						bootstrap.Modal.getInstance(document.getElementById("modalCrearTicket")).hide();
						cargarTabla(1);
					} else {
						return r.text().then(html => {
							document.getElementById("contenidoCrearTicket").innerHTML = html;
							inicializarValidacionArchivos();
							inicializarComboCategoria();
							inicializarComboTipoRequerimiento();
							inicializarFormularioCrearTicket();
						});
					}
				});
			});
		}

		function inicializarComboCategoria() {
			const cboArea = document.getElementById("cboArea");

			cboArea.addEventListener("change", function () {
				cargarCategorias(this.value, null);
			});

			if (cboArea.value) {
				cargarCategorias(cboArea.value, cboArea.dataset.categoriaSeleccionada);
			}
		}

		function cargarCategorias(idArea, idCategoriaSeleccionada) {
			const cboCategoria = document.getElementById("cboCategoria");

			if (!idArea) {
				cboCategoria.innerHTML = '<option value="">Selecciona un área primero...</option>';
				return;
			}

			cboCategoria.innerHTML = '<option value="">Cargando...</option>';

			fetch(`@Url.Action("CategoriasPorArea")?idArea=${idArea}`)
				.then(r => r.json())
				.then(data => {
					cboCategoria.innerHTML = '<option value="">Selecciona...</option>';
					data.forEach(cat => {
						const opt = document.createElement("option");
						opt.value = cat.id;
						opt.textContent = cat.nombre;

						if (idCategoriaSeleccionada && cat.id == idCategoriaSeleccionada) {
							opt.selected = true;
						}

						cboCategoria.appendChild(opt);
					});
				});
		}

		function tomarTicket(idTicket) {
			fetch(`@Url.Action("TomarTicket")?id=${idTicket}`, { method: "POST" })
				.then(r => r.json())
				.then(data => {
					if (!data.exito) {
						mostrarToast(data.mensaje, "danger");
					}
					else{
						mostrarToast("Ticket tomado correctamente", "success");
					}
					cargarTabla(1);
				});
		}

		function abrirAnularTicket(idTicket) {
			document.getElementById("idTicketAnular").value = idTicket;
			document.getElementById("motivoAnulacion").value = "";
			document.getElementById("errorMotivoAnulacion").textContent = "";

			const modal = new bootstrap.Modal(document.getElementById("modalAnularTicket"));
			modal.show();
		}

		function confirmarAnularTicket(){
			const idTicket = document.getElementById("idTicketAnular").value;
			const motivo = document.getElementById("motivoAnulacion").value;

			if (!motivo.trim()) {
				document.getElementById("errorMotivoAnulacion").textContent = "Debes indicar un motivo de anulación.";
				return;
			}

			const params = new URLSearchParams({ id: idTicket, motivo: motivo });

			fetch(`@Url.Action("AnularTicket")?${params.toString()}`, {method: "POST"})
			.then(r => r.json())
			.then(data => {
				if (data.exito) {
					bootstrap.Modal.getInstance(document.getElementById("modalAnularTicket")).hide();
					cargarTabla(1);
				} else {
					document.getElementById("errorMotivoAnulacion").textContent = data.mensaje;
				}
			});
		}

		function asignarPrioridad(idTicket, idPrioridad) {
			if (!idPrioridad) return;

			const params = new URLSearchParams({ id: idTicket, idPrioridad: idPrioridad });

			fetch(`@Url.Action("AsignarPrioridad")?${params.toString()}`, {
				method: "POST"
			})
			.then(r => r.json())
			.then(data => {
				if (!data.exito) {
					mostrarToast("No se pudo asignar la prioridad. Puede que el ticket ya haya cambiado de estado.", "danger");
				}else{
					mostrarToast("Ticket asignado correctamente", "success");
				}
				cargarTabla(1);
			});
		}

		function asignarOrdenAtencion(idTicket, orden) {
			if (!orden) return;

			const params = new URLSearchParams({ id: idTicket, orden: orden });

			fetch(`@Url.Action("AsignarOrdenAtencion")?${params.toString()}`, { method: "POST" })
				.then(r => r.json())
				.then(data => {
					if (!data.exito) {
						mostrarToast("No se pudo asignar el orden de atención.", "danger");
					}else{
						mostrarToast("Orden de atención asignado correctamente.", "success");
					}
					cargarTabla(1);
				});
		}

		function atenderTicket(idTicket) {
				fetch(`@Url.Action("AtenderTicket")?id=${idTicket}`, {
			method: "POST"
		})
		.then(r => r.json())
		.then(data => {
			if (!data.exito){
				mostrarToast("El ticket ya no está disponible para atender.", "danger");
			}else{
				mostrarToast("El ticket se atendió correctamente.", "success");
			}
			cargarTabla(1);
		});
		}

		function abrirPausarTicket(idTicket) {
			document.getElementById("idTicketPausar").value = idTicket;
			document.getElementById("motivoReunion").checked = true;
			document.getElementById("contenedorOtroTicket").style.display = "none";
			document.getElementById("errorPausarTicket").textContent = "";

			const modal = new bootstrap.Modal(document.getElementById("modalPausarTicket"));
			modal.show();
		}

		document.querySelectorAll('input[name="tipoMotivoPausa"]').forEach(radio => {
			radio.addEventListener("change", function () {
				const contenedor = document.getElementById("contenedorOtroTicket");

				if (this.value === "AtencionOtroTicket") {
					contenedor.style.display = "block";
					cargarMisTicketsPropios();
				} else {
					contenedor.style.display = "none";
				}
			});
		});

		function cargarMisTicketsPropios() {
			const idTicketActual = document.getElementById("idTicketPausar").value;
			const cboTicketRelacionado = document.getElementById("cboTicketRelacionado");

			cboTicketRelacionado.innerHTML = '<option value="">Cargando...</option>';

			fetch(`@Url.Action("MisTicketsPropios")?idTicketActual=${idTicketActual}`)
				.then(r => r.json())
				.then(data => {
					cboTicketRelacionado.innerHTML = '<option value="">Selecciona...</option>';
					data.forEach(t => {
						const opt = document.createElement("option");
						opt.value = t.id;
						opt.textContent = t.nombre;
						cboTicketRelacionado.appendChild(opt);
					});
				});
		}

		function confirmarPausarTicket() {
			const idTicket = document.getElementById("idTicketPausar").value;
			const tipoMotivo = document.querySelector('input[name="tipoMotivoPausa"]:checked').value;
			const idTicketRelacionado = document.getElementById("cboTicketRelacionado").value;

			if (tipoMotivo === "AtencionOtroTicket" && !idTicketRelacionado) {
				document.getElementById("errorPausarTicket").textContent = "Selecciona el ticket que vas a atender.";
				return;
			}

			const params = new URLSearchParams({ id: idTicket, tipoMotivo: tipoMotivo });
			if (idTicketRelacionado) {
				params.append("idTicketRelacionado", idTicketRelacionado);
			}

			fetch(`@Url.Action("PausarTicket")?${params.toString()}`, {
				method: "POST"
			})
			.then(r => r.json())
			.then(data => {
				if (data.exito) {
					bootstrap.Modal.getInstance(document.getElementById("modalPausarTicket")).hide();
					cargarTabla(1);
				} else {
					document.getElementById("errorPausarTicket").textContent = data.mensaje || "No se pudo pausar el ticket.";
				}
			});
		}

		function reanudarTicket(idTicket) {
			fetch(`@Url.Action("ReanudarTicket")?id=${idTicket}`, {
				method: "POST"
			})
			.then(r => r.json())
			.then(data => {
				if (!data.exito) {
					mostrarToast("No se pudo reanudar el ticket.", "danger");
				}else {
					mostrarToast("El ticket se reanudó satisfactoriamente.", "success");
				}
				cargarTabla(1);
			});
		}

		function abrirValidarTicket(idTicket) {
			document.getElementById("idTicketValidar").value = idTicket;
			document.getElementById("solucionTicket").value = "";
			document.getElementById("errorValidarTicket").textContent = "";

			const modal = new bootstrap.Modal(document.getElementById("modalValidarTicket"));
			modal.show();
		}

		function confirmarValidarTicket() {
			const idTicket = document.getElementById("idTicketValidar").value;
			const solucion = document.getElementById("solucionTicket").value;

			if (!solucion.trim()) {
				document.getElementById("errorValidarTicket").textContent = "Debes registrar la solución del ticket.";
				return;
			}

			const params = new URLSearchParams({ id: idTicket, solucion: solucion });

			fetch(`@Url.Action("ValidarTicket")?${params.toString()}`, { method: "POST" })
				.then(r => r.json())
