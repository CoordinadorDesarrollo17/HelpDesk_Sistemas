@using HelpDesk_Sistemas.Models
@model List<GuiaModel>

@if (Model.Count == 0)
{
    <p class="text-muted">No se encontraron guías.</p>
}
else
{
    @foreach (var g in Model)
    {
        <div class="col-md-4">
            @{ var resaltada = ViewBag.IdGuiaResaltada is int idResaltada && idResaltada == g.Id; }
            <div class="card h-100 @(resaltada ? "guia-resaltada border-primary border-2 shadow" : "")">
                <div class="card-body">
                    <h6 class="card-title">@g.Titulo</h6>
                    <p class="text-muted small mb-1">@g.Categoria @(g.Subcategoria != null ? " · " + g.Subcategoria : "")</p>
                    <p class="card-text small">@g.Descripcion</p>
                </div>
                <div class="card-footer d-flex justify-content-between align-items-center">
                    <div class="d-flex gap-1">
                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Ver aquí mismo, sin descargar"
                                data-id="@g.Id" data-titulo="@g.Titulo" data-nombre="@g.NombreArchivo" onclick="verGuia(this)">
                            <i class="bi bi-eye"></i> Ver
                        </button>
                        <a class="btn btn-sm btn-outline-primary" href="@Url.Action("DescargarGuia", new { id = g.Id })" target="_blank">
                            <i class="bi bi-download"></i> Descargar
                        </a>
                    </div>
                    @if ((bool)ViewBag.PuedeAdministrar)
                    {
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="eliminarGuia(@g.Id)">
                            <i class="bi bi-trash"></i>
                        </button>
                    }
                </div>
            </div>
        </div>
    }
}