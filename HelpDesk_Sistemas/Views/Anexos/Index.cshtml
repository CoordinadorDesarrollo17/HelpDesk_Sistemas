@using HelpDesk_Sistemas.Models
@model List<GuiaModel>

@{
    ViewData["Title"] = "Guías y Anexos";
    var categorias = (List<GuiaCategoriaModel>)ViewBag.Categorias;
    var puedeAdministrar = (bool)ViewBag.PuedeAdministrar;
}

<div class="card shadow-sm mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold">Guías y Anexos</h5>
        @if (puedeAdministrar)
        {
            <button type="button" class="btn btn-primary btn-sm" onclick="abrirCrearGuia()">
                <i class="bi bi-file-earmark-plus"></i> Nueva guía
            </button>
        }
    </div>
    <div class="card-body">
        <div class="d-flex flex-wrap gap-2 mb-3">
            <input type="text" id="txtBuscarGuia" class="form-control form-control-sm w-auto"
                   style="min-width:240px" placeholder="Buscar por título o descripción..." />
            <select id="filtroGuiaCategoria" class="form-select form-select-sm w-auto">
                <option value="">Todas las categorías</option>
                @foreach (var c in categorias)
                {
                    <option value="@c.Id">@c.Nombre</option>
                }
            </select>
            <select id="filtroGuiaSubcategoria" class="form-select form-select-sm w-auto" disabled>
                <option value="">Todas las subcategorías</option>
            </select>
        </div>

        <div id="listaGuias" class="row g-3">
            @await Html.PartialAsync("_ListaGuias", Model)
        </div>
    </div>
</div>

<div id="contenedorModalGuia"></div>

@section Scripts {
    <script>
        const filtroBuscar = document.getElementById("txtBuscarGuia");
        const filtroCat = document.getElementById("filtroGuiaCategoria");
        const filtroSub = document.getElementById("filtroGuiaSubcategoria");

        // Categoría → Subcategoría: mismo patrón que ya usas en el formulario de
        // crear ticket (área → tipo de atención).
        filtroCat.addEventListener("change", function () {
            filtroSub.innerHTML = '<option value="">Todas las subcategorías</option>';
            if (!this.value) { filtroSub.disabled = true; buscarGuias(); return; }

            fetch(`@Url.Action("SubcategoriasPorCategoria")?idCategoria=${this.value}`)
                .then(r => r.json())
                .then(subs => {
                    subs.forEach(s => filtroSub.insertAdjacentHTML("beforeend", `<option value="${s.id}">${s.nombre}</option>`));
                    filtroSub.disabled = subs.length === 0;
                });
            buscarGuias();
        });
        filtroSub.addEventListener("change", buscarGuias);

        let temporizadorBusqueda;
        filtroBuscar.addEventListener("input", function () {
            clearTimeout(temporizadorBusqueda);
            temporizadorBusqueda = setTimeout(buscarGuias, 300);
        });

        function buscarGuias() {
            const params = new URLSearchParams({
                buscar: filtroBuscar.value,
                idCategoria: filtroCat.value,
                idSubcategoria: filtroSub.value
            });
            fetch(`@Url.Action("Index")?${params.toString()}`, { headers: { "X-Requested-With": "XMLHttpRequest" } })
                .then(r => r.text())
                .then(html => {
                    document.getElementById("listaGuias").innerHTML = html;
                });
        }

        function abrirCrearGuia() {
            fetch(`@Url.Action("CrearGuia")`)
                .then(r => r.text())
                .then(mostrarModalGuia);
        }

        // Monta el HTML del modal y lo abre con Bootstrap. Se usa tanto al abrirlo como
        // cuando el servidor lo reenvía por un error de validación: en ese caso el
        // elemento del modal es NUEVO, así que se descarta la instancia y el fondo
        // oscuro del anterior (si no, Bootstrap seguiría apuntando al elemento viejo y
        // después no podría cerrar el nuevo).
        function mostrarModalGuia(html) {
            const anterior = document.getElementById("modalCrearGuia");
            if (anterior) {
                bootstrap.Modal.getInstance(anterior)?.dispose();
                document.querySelectorAll(".modal-backdrop").forEach(b => b.remove());
                document.body.classList.remove("modal-open");
                document.body.style.removeProperty("overflow");
                document.body.style.removeProperty("padding-right");
            }

            document.getElementById("contenedorModalGuia").innerHTML = html;
            new bootstrap.Modal(document.getElementById("modalCrearGuia")).show();
            inicializarFormularioGuia();
        }

        // _CrearGuia.cshtml se inserta con innerHTML, y un <script> insertado así
        // nunca lo ejecuta el navegador — por eso los listeners viven acá, y hay que
        // volver a llamarlos cada vez que ese HTML se vuelve a insertar: al abrir el
        // modal (arriba) y también si el servidor lo reenvía por un error de
        // validación (abajo) — si no, un segundo intento de "Guardar" ya no tendría
        // el manejador de submit y el formulario se enviaría de la forma nativa del
        // navegador (recargando la página en crudo) en vez de mostrar el error.
        function inicializarFormularioGuia() {
            const cboCategoria = document.getElementById("cboGuiaCategoria");
            const cboSubcategoria = document.getElementById("cboGuiaSubcategoria");
            const form = document.getElementById("formCrearGuia");

            function cargarSubcategorias(idSeleccionada) {
                cboSubcategoria.innerHTML = '<option value="">Selecciona...</option>';
                cboSubcategoria.disabled = !cboCategoria.value;
                if (!cboCategoria.value) return;

                fetch(`@Url.Action("SubcategoriasPorCategoria")?idCategoria=${cboCategoria.value}`)
                    .then(r => r.json())
                    .then(subs => {
                        subs.forEach(s => cboSubcategoria.insertAdjacentHTML("beforeend", `<option value="${s.id}">${s.nombre}</option>`));
                        cboSubcategoria.disabled = subs.length === 0;
                        if (idSeleccionada) cboSubcategoria.value = idSeleccionada;
                    });
            }

            cboCategoria.addEventListener("change", () => cargarSubcategorias());

            // Si el servidor reenvió el formulario por un error de validación, la categoría
            // (y la subcategoría) ya vienen elegidas: se recargan las subcategorías para
            // no perder lo que el usuario había escogido.
            if (cboCategoria.value) {
                cargarSubcategorias(cboSubcategoria.dataset.subcategoriaSeleccionada);
            }

            form.addEventListener("submit", function (e) {
                e.preventDefault();

                fetch(this.action, { method: "POST", body: new FormData(this) })
                    .then(r => {
                        if (r.ok) {
                            bootstrap.Modal.getInstance(document.getElementById("modalCrearGuia"))?.hide();
                            buscarGuias();
                        } else {
                            r.text().then(mostrarModalGuia);
                        }
                    });
            });
        }

        function eliminarGuia(id) {
            if (!confirm("¿Eliminar esta guía? Ya no se va a mostrar en el listado.")) return;

            fetch(`@Url.Action("EliminarGuia")?id=${id}`, { method: "POST" })
                .then(r => r.json())
                .then(data => {
                    if (data.exito) {
                        buscarGuias();
                    } else {
                        alert(data.mensaje || "No se pudo eliminar la guía.");
                    }
                });
        }
    </script>
}