@using HelpDesk_Sistemas.Models
@model CrearGuiaModel

@{
    var categorias = (List<GuiaCategoriaModel>)ViewBag.Categorias;
}

<div class="modal fade" id="modalCrearGuia" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="formCrearGuia" asp-controller="Anexos" asp-action="CrearGuia" method="post" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5 class="modal-title">Nueva guía</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Título <span class="text-danger">*</span></label>
                        <input type="text" name="Titulo" class="form-control" value="@Model?.Titulo" />
                        <span asp-validation-for="Titulo" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Descripción</label>
                        <textarea name="Descripcion" class="form-control" rows="2">@Model?.Descripcion</textarea>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label class="form-label">Categoría <span class="text-danger">*</span></label>
                            <select id="cboGuiaCategoria" name="IdGuiaCategoria" class="form-select">
                                <option value="">Selecciona...</option>
                                @foreach (var c in categorias)
                                {
                                    <option value="@c.Id" selected="@(Model?.IdGuiaCategoria == c.Id)">@c.Nombre</option>
                                }
                            </select>
                            <span asp-validation-for="IdGuiaCategoria" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Subcategoría</label>
                            <select id="cboGuiaSubcategoria" name="IdSubcategoria" class="form-select" disabled
                                    data-subcategoria-seleccionada="@Model?.IdSubcategoria">
                                <option value="">Selecciona una categoría primero...</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Archivo <span class="text-danger">*</span></label>
                        <input type="file" name="Archivo" class="form-control" accept=".jpg,.jpeg,.png,.pdf,.docx,.xlsx,.ppt,.pptx,.mp4" />
                        <span asp-validation-for="Archivo" class="text-danger small"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Sin <script> aquí: este parcial se inserta con innerHTML (ver abrirCrearGuia en
   Index.cshtml), y un <script> insertado así nunca se ejecuta — es una regla del
   propio navegador, no un descuido. La inicialización (los mismos dos listeners
   que antes estaban acá) vive en Index.cshtml, en inicializarFormularioGuia(),
   y se llama a mano cada vez que este HTML se inserta: al abrir el modal por
   primera vez, y de nuevo si el servidor lo vuelve a enviar por un error de
   validación (si no, el segundo intento de "Guardar" ya no tendría el manejador
   de submit y el formulario se enviaría de la forma nativa del navegador —
   recargando la página en crudo en vez de mostrar el error). *@