@using HelpDesk_Sistemas.Models
@model CrearGuiaModel

@{
    var categorias = (List<GuiaCategoriaModel>)ViewBag.Categorias;
}

<div class="modal fade show" id="modalCrearGuia" tabindex="-1" style="display:block">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="formCrearGuia" asp-controller="Anexos" asp-action="CrearGuia" method="post" enctype="multipart/form-data">
                <div class="modal-header">
                    <h5 class="modal-title">Nueva guía</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Título <span class="text-danger">*</span></label>
                        <input type="text" name="Titulo" class="form-control" />
                        <span asp-validation-for="Titulo" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Descripción</label>
                        <textarea name="Descripcion" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label class="form-label">Categoría <span class="text-danger">*</span></label>
                            <select id="cboGuiaCategoria" name="IdGuiaCategoria" class="form-select">
                                <option value="">Selecciona...</option>
                                @foreach (var c in categorias)
                                {
                                    <option value="@c.Id">@c.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Subcategoría</label>
                            <select id="cboGuiaSubcategoria" name="IdSubcategoria" class="form-select" disabled>
                                <option value="">Selecciona una categoría primero...</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Archivo <span class="text-danger">*</span></label>
                        <input type="file" name="Archivo" class="form-control" accept=".jpg,.jpeg,.png,.pdf,.docx,.xlsx,.ppt,.pptx,.mp4" />
                        <span asp-validation-for="Archivo" class="text-danger small"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.getElementById("cboGuiaCategoria").addEventListener("change", function () {
        const cboSub = document.getElementById("cboGuiaSubcategoria");
        cboSub.innerHTML = '<option value="">Selecciona...</option>';
        cboSub.disabled = !this.value;
        if (!this.value) return;

        fetch(`/Anexos/SubcategoriasPorCategoria?idCategoria=${this.value}`)
            .then(r => r.json())
            .then(subs => subs.forEach(s => cboSub.insertAdjacentHTML("beforeend", `<option value="${s.id}">${s.nombre}</option>`)));
    });

    document.getElementById("formCrearGuia").addEventListener("submit", function (e) {
        e.preventDefault();
        fetch(this.action, { method: "POST", body: new FormData(this) })
            .then(r => r.ok ? location.reload() : r.text().then(html => document.getElementById("contenedorModalGuia").innerHTML = html));
    });
</script>