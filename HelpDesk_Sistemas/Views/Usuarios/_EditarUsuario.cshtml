@using HelpDesk_Sistemas.Models
@model EditarUsuarioModel

@{
    // El Rol no se edita aquí, así que el área se filtra server-side contra el
    // Rol ya guardado (a diferencia de Crear, donde el Rol se elige en el mismo
    // formulario y el filtrado se hace en vivo con JS).
    var soloAreasSistemas = Model.Rol is "Administrador" or "Soporte";
    var areasDisponibles = ((List<AreaModel>)ViewBag.Areas)
        .Where(a => !soloAreasSistemas || a.EsAreaSistemas)
        .ToList();
}

<form id="formEditarUsuario" method="post">
    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="row g-3">
        <div class="col-sm-6">
            <label class="form-label">Nombre <span class="text-danger">*</span></label>
            <input type="text" name="Nombre" class="form-control" required value="@Model.Nombre" />
        </div>
        <div class="col-sm-6">
            <label class="form-label">Apellido <span class="text-danger">*</span></label>
            <input type="text" name="Apellido" class="form-control" required value="@Model.Apellido" />
        </div>

        <div class="col-sm-6">
            <label class="form-label">Correo</label>
            <input type="email" name="Correo" class="form-control" value="@Model.Correo" />
        </div>
        <div class="col-sm-6">
            <label class="form-label">Nro. de contacto</label>
            <input type="text" name="NroContacto" class="form-control" value="@Model.NroContacto" />
        </div>

        <div class="col-sm-6">
            <label class="form-label">Área <span class="text-danger">*</span></label>
            <select name="IdArea" class="form-select" required>
                <option value="">Selecciona...</option>
                @foreach (var area in areasDisponibles)
                {
                    <option value="@area.Id" selected="@(Model.IdArea == area.Id)">@area.Nombre</option>
                }
            </select>
            @if (soloAreasSistemas)
            {
                <small class="text-muted">Administrador y Soporte solo pueden ser de un área de soporte (TI, Sistemas o Desarrollo).</small>
            }
        </div>
        <div class="col-12">
            <label class="form-label">Sociedades <span class="text-danger">*</span></label>
            <div class="d-flex flex-wrap gap-3">
                @foreach (var soc in (List<CatalogoModel>)ViewBag.Sociedades)
                {
                    <div class="form-check">
                        <input type="checkbox" name="IdSociedades" value="@soc.Id" class="form-check-input"
                               id="socEditar@(soc.Id)" checked="@Model.IdSociedades.Contains(soc.Id)" />
                        <label class="form-check-label" for="socEditar@(soc.Id)">@soc.Nombre</label>
                    </div>
                }
            </div>
            <small class="text-muted">El usuario puede pertenecer a más de una sociedad, pero debe tener al menos una.</small>
        </div>

        <div class="col-sm-6">
            <label class="form-label">Supervisor (opcional)</label>
            <select name="IdSupUsuario" class="form-select">
                <option value="">Ninguno</option>
                @foreach (var sup in (List<CatalogoModel>)ViewBag.Supervisores)
                {
                    if (sup.Id == Model.Id) { continue; }
                    <option value="@sup.Id" selected="@(Model.IdSupUsuario == sup.Id)">@sup.Nombre</option>
                }
            </select>
        </div>

        <div class="col-sm-6 d-flex align-items-end">
            <div class="form-check">
                <input type="checkbox" name="EsCoordinador" value="true" class="form-check-input" id="chkCoordinadorEditar" checked="@Model.EsCoordinador" />
                <label class="form-check-label" for="chkCoordinadorEditar">Es coordinador</label>
            </div>
        </div>

        <div class="col-12">
            <small class="text-muted">
                <i class="bi bi-info-circle"></i>
                El rol, el usuario y la contraseña no se editan aquí. El usuario ya generado no
                cambia aunque cambies el Área — el prefijo solo se usa una vez, al crear la cuenta.
            </small>
        </div>

        <div class="col-12">
            @* Se muestran todos los errores (de campo y de modelo): este formulario no usa
               spans asp-validation-for por campo, así que si solo se leyera ModelState[""]
               los errores de validación de campo quedarían invisibles. *@
            <span id="errorEditarUsuario" class="text-danger small">@string.Join(" ", ViewData.ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage))</span>
        </div>
    </div>

    <div class="modal-footer px-0 pb-0">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
    </div>
</form>
