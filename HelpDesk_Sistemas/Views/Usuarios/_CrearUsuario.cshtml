@using HelpDesk_Sistemas.Models
@model CrearUsuarioModel

<form id="formCrearUsuario" method="post">
    <div class="row g-3">
        <div class="col-sm-6">
            <label class="form-label">Nombre <span class="text-danger">*</span></label>
            <input type="text" name="Nombre" class="form-control" required value="@Model.Nombre" />
        </div>
        <div class="col-sm-6">
            <label class="form-label">Apellido <span class="text-danger">*</span></label>
            <input type="text" name="Apellido" class="form-control" required value="@Model.Apellido" />
        </div>

        <div class="col-sm-6">
            <label class="form-label">Correo</label>
            <input type="email" name="Correo" class="form-control" value="@Model.Correo" />
        </div>
        <div class="col-sm-6">
            <label class="form-label">Nro. de contacto</label>
            <input type="text" name="NroContacto" class="form-control" value="@Model.NroContacto" />
        </div>

        <div class="col-sm-6">
            <label class="form-label">Rol <span class="text-danger">*</span></label>
            <select name="IdRol" class="form-select" required>
                <option value="">Selecciona...</option>
                @foreach (var rol in (List<CatalogoModel>)ViewBag.Roles)
                {
                    <option value="@rol.Id" selected="@(Model.IdRol == rol.Id)">@rol.Nombre</option>
                }
            </select>
        </div>
        <div class="col-sm-6">
            <label class="form-label">Área <span class="text-danger">*</span></label>
            <select name="IdArea" class="form-select" required>
                <option value="">Selecciona...</option>
                @foreach (var area in (List<CatalogoModel>)ViewBag.Areas)
                {
                    <option value="@area.Id" selected="@(Model.IdArea == area.Id)">@area.Nombre</option>
                }
            </select>
        </div>

        <div class="col-sm-6">
            <label class="form-label">Supervisor (opcional)</label>
            <select name="IdSupUsuario" class="form-select">
                <option value="">Ninguno</option>
                @foreach (var sup in (List<CatalogoModel>)ViewBag.Supervisores)
                {
                    <option value="@sup.Id" selected="@(Model.IdSupUsuario == sup.Id)">@sup.Nombre</option>
                }
            </select>
        </div>
        <div class="col-sm-6 d-flex align-items-end">
            <div class="form-check">
                <input type="checkbox" name="EsCoordinador" value="true" class="form-check-input" id="chkCoordinador" checked="@Model.EsCoordinador" />
                <label class="form-check-label" for="chkCoordinador">Es coordinador</label>
            </div>
        </div>

        <div class="col-12">
            <small class="text-muted">
                <i class="bi bi-info-circle"></i>
                El usuario y la contraseña se generan automáticamente al guardar, siguiendo la convención de Cobefar
                (rol + número secuencial / 3 letras de nombre y apellido + el mismo número).
            </small>
        </div>

        <div class="col-12">
            <span id="errorCrearUsuario" class="text-danger small">@(ViewData.ModelState.IsValid ? "" : string.Join(" ", ViewData.ModelState[""]?.Errors.Select(e => e.ErrorMessage) ?? Array.Empty<string>()))</span>
        </div>
    </div>

    <div class="modal-footer px-0 pb-0">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-primary">Crear usuario</button>
    </div>
</form>
