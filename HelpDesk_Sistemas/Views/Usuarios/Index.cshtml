@using HelpDesk_Sistemas.Models
@model List<UsuarioModel>

@{
    ViewData["Title"] = "Usuarios";
    var roles = Model.Select(u => u.Rol).Distinct().OrderBy(r => r).ToList();
    var departamentos = Model.Select(u => u.Departamento).Where(d => !string.IsNullOrEmpty(d)).Distinct().OrderBy(d => d).ToList();
    var sociedades = Model.SelectMany(u => (u.Sociedades ?? "").Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)).Distinct().OrderBy(s => s).ToList();
}

<div class="card shadow-sm mb-4">
    <div class="card-header header-gradient text-black d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold">Usuarios</h5>
        <button type="button" class="btn btn-primary btn-sm" onclick="abrirCrearUsuario()">
            <i class="bi bi-person-plus"></i> Nuevo usuario
        </button>
    </div>

    <div class="card-body">
        <!-- FILTROS Y BUSCADOR -->
        <div class="d-flex flex-wrap gap-2 mb-3">
            <input type="text" id="txtBuscarUsuario" class="form-control form-control-sm w-auto"
                   style="min-width: 220px;" placeholder="Buscar por nombre, usuario o correo..." autocomplete="off" />

            <select id="filtroRol" class="form-select form-select-sm w-auto">
                <option value="">Todos los roles</option>
                @foreach (var rol in roles)
                {
                    <option value="@rol">@rol</option>
                }
            </select>

            <select id="filtroDepartamento" class="form-select form-select-sm w-auto">
                <option value="">Todos los departamentos</option>
                @foreach (var dep in departamentos)
                {
                    <option value="@dep">@dep</option>
                }
            </select>

            <select id="filtroSociedad" class="form-select form-select-sm w-auto">
                <option value="">Todas las sociedades</option>
                @foreach (var soc in sociedades)
                {
                    <option value="@soc">@soc</option>
                }
            </select>

            <select id="filtroActivo" class="form-select form-select-sm w-auto">
                <option value="">Activos e inactivos</option>
                <option value="1">Solo activos</option>
                <option value="0">Solo inactivos</option>
            </select>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle" id="tablaUsuarios">
                <thead class="table-header">
                    <tr>
                        <th>Nombre</th>
                        <th>Usuario</th>
                        <th>Rol</th>
                        <th>Departamento</th>
                        <th>Área</th>
                        <th>Sociedades</th>
                        <th>Correo</th>
                        <th>Activo</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr data-nombre="@($"{u.Nombre} {u.Apellido}".ToLower())"
                            data-usuario="@u.Usuario.ToLower()"
                            data-correo="@(u.Correo ?? "").ToLower()"
                            data-rol="@u.Rol"
                            data-departamento="@u.Departamento"
                            data-sociedades="@u.Sociedades"
                            data-activo="@(u.Activo ? "1" : "0")">
                            <td>@u.Nombre @u.Apellido</td>
                            <td><code>@u.Usuario</code></td>
                            <td><span class="badge bg-primary">@u.Rol</span></td>
                            <td>@(u.Departamento ?? "-")</td>
                            <td>@u.Area</td>
                            <td>@(string.IsNullOrEmpty(u.Sociedades) ? "-" : u.Sociedades)</td>
                            <td>@(u.Correo ?? "-")</td>
                            <td>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch"
                                           @(u.Activo ? "checked" : "")
                                           onchange="cambiarActivoUsuario(@u.Id, this.checked)">
                                </div>
                            </td>
                            <td class="text-nowrap">
                                <button type="button" class="btn btn-sm btn-outline-secondary" title="Editar" onclick="abrirEditarUsuario(@u.Id)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger" title="Eliminar" data-nombre="@u.Nombre @u.Apellido" onclick="eliminarUsuario(@u.Id, this.dataset.nombre)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="text-muted small mb-0 d-none" id="avisoSinResultadosUsuarios">Ningún usuario coincide con los filtros.</p>
        </div>
    </div>
</div>

<!-- MODAL CREAR USUARIO -->
<div class="modal fade" id="modalCrearUsuario" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Nuevo usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="contenidoCrearUsuario">
            </div>
        </div>
    </div>
</div>

<!-- MODAL EDITAR USUARIO -->
<div class="modal fade" id="modalEditarUsuario" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Editar usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="contenidoEditarUsuario">
            </div>
        </div>
    </div>
</div>

<!-- MODAL CREDENCIALES GENERADAS -->
<div class="modal fade" id="modalCredenciales" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-shield-check text-success"></i> Usuario creado</h5>
            </div>
            <div class="modal-body">
                <p class="text-muted small">Copia estas credenciales ahora — la contraseña no se vuelve a mostrar.</p>
                <div class="mb-2">
                    <label class="form-label small mb-0">Usuario</label>
                    <input type="text" id="txtCredencialUsuario" class="form-control" readonly />
                </div>
                <div>
                    <label class="form-label small mb-0">Contraseña</label>
                    <input type="text" id="txtCredencialPassword" class="form-control" readonly />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal" onclick="window.location.reload()">Listo</button>
            </div>
        </div>
    </div>
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
    <div id="toastGenerico" class="toast align-items-center border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body" id="toastMensaje"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function fetchConManejo(url, opciones) {
            return fetch(url, opciones).catch(error => {
                console.error(error);
                mostrarToast("No se pudo conectar con el servidor. Revisa tu conexión.", "danger");
                return null;
            });
        }

        function mostrarToast(mensaje, tipo = "danger") {
            const toastEl = document.getElementById("toastGenerico");
            const toastMensaje = document.getElementById("toastMensaje");
            toastEl.classList.remove("text-bg-success", "text-bg-danger", "text-bg-warning");
            toastEl.classList.add(`text-bg-${tipo}`);
            toastMensaje.textContent = mensaje;
            new bootstrap.Toast(toastEl, { delay: 4000 }).show();
        }

        function abrirCrearUsuario() {
            const modal = new bootstrap.Modal(document.getElementById("modalCrearUsuario"));
            const contenido = document.getElementById("contenidoCrearUsuario");

            contenido.innerHTML = "Cargando...";
            modal.show();

            fetchConManejo(`@Url.Action("CrearUsuario")`)
                .then(r => r && r.text())
                .then(html => {
                    if (!html) return;
                    contenido.innerHTML = html;
                    inicializarFormularioUsuario();
                });
        }

        // Llena un <select> de Área con una lista fija [{id,nombre}] (las 3 áreas de soporte).
        function poblarAreaFija(selArea, areas, idSeleccionado) {
            selArea.innerHTML = '<option value="">Selecciona...</option>';
            areas.forEach(a => {
                const opt = document.createElement("option");
                opt.value = a.id;
                opt.textContent = a.nombre;
                opt.selected = idSeleccionado != null && a.id === Number(idSeleccionado);
                selArea.appendChild(opt);
            });
            selArea.disabled = false;
        }

        // Deja el <select> de Área vacío y deshabilitado hasta elegir un departamento.
        function vaciarArea(selArea, texto) {
            selArea.innerHTML = `<option value="">${texto}</option>`;
            selArea.disabled = true;
        }

        // Carga por AJAX las áreas del departamento elegido. Si areaInactivaActual viene
        // informado (solo pasa en Editar, cuando el área actual del usuario está inactiva) y no
        // aparece en la lista de áreas activas que devuelve el servidor, se agrega igual como
        // opción extra marcada "(inactiva)" y preseleccionada — así nunca se pierde en silencio
        // la asignación real de alguien solo porque su área fue desactivada mientras tanto.
        function cargarAreasPorDepartamento(idDepartamento, selArea, idSeleccionado, areaInactivaActual) {
            if (!idDepartamento) {
                vaciarArea(selArea, "Selecciona un departamento primero...");
                return;
            }

            fetchConManejo(`@Url.Action("AreasPorDepartamento")?idDepartamento=${idDepartamento}`)
                .then(r => r && r.json())
                .then(areas => {
                    if (!areas) return;
                    selArea.innerHTML = '<option value="">Selecciona...</option>';
                    areas.forEach(a => {
                        const opt = document.createElement("option");
                        opt.value = a.id;
                        opt.textContent = a.nombre;
                        opt.selected = idSeleccionado != null && a.id === Number(idSeleccionado);
                        selArea.appendChild(opt);
                    });

                    if (areaInactivaActual && !areas.some(a => Number(a.id) === areaInactivaActual.id)) {
                        const opt = document.createElement("option");
                        opt.value = areaInactivaActual.id;
                        opt.textContent = `${areaInactivaActual.nombre} (inactiva)`;
                        opt.selected = true;
                        selArea.appendChild(opt);
                    }

                    selArea.disabled = false;
                });
        }

        // Carga por AJAX los supervisores del mismo departamento (idExcluir se usa al editar,
        // para que el propio usuario no pueda elegirse a sí mismo).
        function cargarSupervisoresPorDepartamento(idDepartamento, selSupervisor, idExcluir, idSeleccionado) {
            if (!idDepartamento) {
                selSupervisor.innerHTML = '<option value="">Ninguno</option>';
                return;
            }

            const params = new URLSearchParams({ idDepartamento });
            if (idExcluir) params.append("idExcluir", idExcluir);

            fetchConManejo(`@Url.Action("SupervisoresPorDepartamento")?${params.toString()}`)
                .then(r => r && r.json())
                .then(supervisores => {
                    if (!supervisores) return;
                    selSupervisor.innerHTML = '<option value="">Ninguno</option>';
                    supervisores.forEach(s => {
                        const opt = document.createElement("option");
                        opt.value = s.id;
                        opt.textContent = s.nombre;
                        opt.selected = idSeleccionado != null && s.id === Number(idSeleccionado);
                        selSupervisor.appendChild(opt);
                    });
                });
        }

        // "Es coordinador" solo aplica a gente de Sistemas (habilita el botón de
        // Reasignar ticket para Soporte): se oculta y se destilda para cualquier otro
        // departamento. "esSistemas" viene forzado (true/false) cuando ya se sabe por el
        // Rol (rama plana); si no se pasa, se deduce del texto del Departamento elegido.
        function actualizarVisibilidadCoordinador(form, esSistemas) {
            const grupo = form.querySelector('[id^="grupoCoordinador"]');
            const chk = grupo?.querySelector('input[type="checkbox"]');
            if (!grupo || !chk) return;

            if (esSistemas === undefined) {
                const selDepartamento = form.querySelector('[id^="selDepartamento"]');
                esSistemas = selDepartamento?.selectedOptions[0]?.textContent === "DEP. DE SISTEMAS";
            }

            grupo.classList.toggle("d-none", !esSistemas);
            if (!esSistemas) chk.checked = false;
        }

        // Administrador y Soporte solo pueden estar en una de las 3 áreas de soporte (se
        // llenan directo, sin elegir Departamento); Supervisor y Usuario eligen primero un
        // Departamento y luego su Área (cascade por AJAX). Si el área ya elegida deja de
        // ser válida para el nuevo rol, se limpia la selección.
        function actualizarAreaPorRol(idSelectRol, idFormulario, idSeleccionadoPrevio) {
            const selRol = document.getElementById(idSelectRol);
            const form = document.getElementById(idFormulario);
            const selArea = form.querySelector('[name="IdArea"]');
            const selSupervisor = form.querySelector('[name="IdSupUsuario"]');
            const grupoDepartamento = form.querySelector('[id^="grupoDepartamento"]');
            const selDepartamento = form.querySelector('[id^="selDepartamento"]');
            const idDepartamentoSistemas = form.dataset.idDepartamentoSistemas;
            if (!selRol || !selArea) return;

            const nombreRol = selRol.selectedOptions[0]?.dataset.nombre;
            const soloSistemas = nombreRol === "Administrador" || nombreRol === "Soporte";
            const aviso = selArea.parentElement.querySelector("small");
            const areasSistemas = JSON.parse(form.dataset.areasSistemas || "[]");

            aviso?.classList.toggle("d-none", !soloSistemas);
            grupoDepartamento?.classList.toggle("d-none", !nombreRol || soloSistemas);

            if (soloSistemas) {
                poblarAreaFija(selArea, areasSistemas, idSeleccionadoPrevio);
                actualizarVisibilidadCoordinador(form, true);
                if (selSupervisor) {
                    cargarSupervisoresPorDepartamento(idDepartamentoSistemas, selSupervisor, form.dataset.idUsuario, form.dataset.supervisorActual);
                }
            } else if (!nombreRol) {
                vaciarArea(selArea, "Selecciona un rol primero...");
                actualizarVisibilidadCoordinador(form, false);
                if (selSupervisor) selSupervisor.innerHTML = '<option value="">Ninguno</option>';
            } else {
                if (selDepartamento) selDepartamento.value = "";
                vaciarArea(selArea, "Selecciona un departamento primero...");
                actualizarVisibilidadCoordinador(form, false);
                if (selSupervisor) selSupervisor.innerHTML = '<option value="">Ninguno</option>';
            }
        }

        function inicializarFormularioUsuario() {
            const form = document.getElementById("formCrearUsuario");
            actualizarAreaPorRol("selRolCrear", "formCrearUsuario");

            document.getElementById("selDepartamentoCrear")?.addEventListener("change", function () {
                cargarAreasPorDepartamento(this.value, document.getElementById("selAreaCrear"));
                cargarSupervisoresPorDepartamento(this.value, document.getElementById("selSupervisorCrear"));
                actualizarVisibilidadCoordinador(form);
            });

            form.addEventListener("submit", function (e) {
                e.preventDefault();

                const params = new URLSearchParams(new FormData(form));

                fetchConManejo(`@Url.Action("CrearUsuario")?${params.toString()}`, { method: "POST" })
                    .then(r => {
                        if (!r) return;
                        if (r.ok) {
                            return r.json().then(data => {
                                if (!data.exito) {
                                    mostrarToast(data.mensaje || "No se pudo crear el usuario.", "danger");
                                    return;
                                }
                                bootstrap.Modal.getInstance(document.getElementById("modalCrearUsuario")).hide();
                                document.getElementById("txtCredencialUsuario").value = data.usuario;
                                document.getElementById("txtCredencialPassword").value = data.password;
                                new bootstrap.Modal(document.getElementById("modalCredenciales")).show();
                            });
                        } else {
                            return r.text().then(html => {
                                document.getElementById("contenidoCrearUsuario").innerHTML = html;
                                inicializarFormularioUsuario();
                            });
                        }
                    });
            });
        }

        function abrirEditarUsuario(id) {
            const modal = new bootstrap.Modal(document.getElementById("modalEditarUsuario"));
            const contenido = document.getElementById("contenidoEditarUsuario");

            contenido.innerHTML = "Cargando...";
            modal.show();

            fetchConManejo(`@Url.Action("EditarUsuario")?id=${id}`)
                .then(r => r && r.text())
                .then(html => {
                    if (!html) return;
                    contenido.innerHTML = html;
                    inicializarFormularioEditarUsuario();
                });
        }

        function inicializarFormularioEditarUsuario() {
            const form = document.getElementById("formEditarUsuario");
            const selArea = document.getElementById("selAreaEditar");
            const selSupervisor = document.getElementById("selSupervisorEditar");
            const selDepartamento = document.getElementById("selDepartamentoEditar");
            const soloAreasSistemas = form.dataset.soloAreasSistemas === "true";
            const idAreaActual = form.dataset.areaActual;
            const idUsuario = form.dataset.idUsuario;
            const idSupervisorActual = form.dataset.supervisorActual;
            const areaActualActiva = form.dataset.areaActualActiva === "true";
            const areaInactivaActual = areaActualActiva ? null : { id: Number(idAreaActual), nombre: form.dataset.areaActualNombre };

            if (soloAreasSistemas) {
                poblarAreaFija(selArea, JSON.parse(form.dataset.areasSistemas || "[]"), idAreaActual);
                actualizarVisibilidadCoordinador(form, true);
                cargarSupervisoresPorDepartamento(form.dataset.idDepartamentoSistemas, selSupervisor, idUsuario, idSupervisorActual);
            } else {
                document.getElementById("grupoDepartamentoEditar")?.classList.remove("d-none");
                const idDepartamentoActual = form.dataset.departamentoActual;
                if (selDepartamento && idDepartamentoActual) {
                    selDepartamento.value = idDepartamentoActual;
                }
                cargarAreasPorDepartamento(idDepartamentoActual, selArea, idAreaActual, areaInactivaActual);
                cargarSupervisoresPorDepartamento(idDepartamentoActual, selSupervisor, idUsuario, idSupervisorActual);
                actualizarVisibilidadCoordinador(form);
            }

            selDepartamento?.addEventListener("change", function () {
                cargarAreasPorDepartamento(this.value, selArea);
                cargarSupervisoresPorDepartamento(this.value, selSupervisor, idUsuario);
                actualizarVisibilidadCoordinador(form);
            });

            form.addEventListener("submit", function (e) {
                e.preventDefault();

                const params = new URLSearchParams(new FormData(form));

                fetchConManejo(`@Url.Action("EditarUsuario")?${params.toString()}`, { method: "POST" })
                    .then(r => {
                        if (!r) return;
                        if (r.ok) {
                            return r.json().then(data => {
                                if (!data.exito) {
                                    mostrarToast(data.mensaje || "No se pudo actualizar el usuario.", "danger");
                                    return;
                                }
                                bootstrap.Modal.getInstance(document.getElementById("modalEditarUsuario")).hide();
                                mostrarToast("Usuario actualizado.", "success");
                                window.location.reload();
                            });
                        } else {
                            return r.text().then(html => {
                                document.getElementById("contenidoEditarUsuario").innerHTML = html;
                                inicializarFormularioEditarUsuario();
                            });
                        }
                    });
            });
        }

        function eliminarUsuario(id, nombre) {
            if (!confirm(`¿Eliminar al usuario "${nombre}"? Esta acción no se puede deshacer.`)) {
                return;
            }

            fetchConManejo(`@Url.Action("EliminarUsuario")?id=${id}`, { method: "POST" })
                .then(r => r && r.json())
                .then(data => {
                    if (!data) return;
                    if (!data.exito) {
                        mostrarToast(data.mensaje || "No se pudo eliminar el usuario.", "danger");
                    } else {
                        mostrarToast("Usuario eliminado.", "success");
                        window.location.reload();
                    }
                });
        }

        function cambiarActivoUsuario(id, activo) {
            const params = new URLSearchParams({ id: id, activo: activo });

            fetchConManejo(`@Url.Action("CambiarActivo")?${params.toString()}`, { method: "POST" })
                .then(r => r && r.json())
                .then(data => {
                    if (!data) return;
                    if (!data.exito) {
                        mostrarToast("No se pudo actualizar el usuario.", "danger");
                    } else {
                        mostrarToast("Usuario actualizado.", "success");
                    }
                });
        }

        // ============================================================
        // FILTROS Y BUSCADOR DEL LISTADO (todo client-side: la tabla ya
        // viene completa en la página, sin paginación por AJAX).
        // ============================================================
        function filtrarTablaUsuarios() {
            const texto = txtBuscarUsuario.value.trim().toLowerCase();
            const rol = filtroRol.value;
            const departamento = filtroDepartamento.value;
            const sociedad = filtroSociedad.value;
            const activo = filtroActivo.value;

            let visibles = 0;

            document.querySelectorAll("#tablaUsuarios tbody tr").forEach(fila => {
                const coincideTexto = !texto
                    || fila.dataset.nombre.includes(texto)
                    || fila.dataset.usuario.includes(texto)
                    || fila.dataset.correo.includes(texto);
                const coincideRol = !rol || fila.dataset.rol === rol;
                const coincideDepartamento = !departamento || fila.dataset.departamento === departamento;
                const coincideSociedad = !sociedad || (fila.dataset.sociedades || "").split(",").map(s => s.trim()).includes(sociedad);
                const coincideActivo = !activo || fila.dataset.activo === activo;

                const visible = coincideTexto && coincideRol && coincideDepartamento && coincideSociedad && coincideActivo;
                fila.classList.toggle("d-none", !visible);
                if (visible) visibles++;
            });

            document.getElementById("avisoSinResultadosUsuarios").classList.toggle("d-none", visibles > 0);
        }

        ["filtroRol", "filtroDepartamento", "filtroSociedad", "filtroActivo"].forEach(id => {
            document.getElementById(id).addEventListener("change", filtrarTablaUsuarios);
        });
        txtBuscarUsuario.addEventListener("input", filtrarTablaUsuarios);
    </script>
}
