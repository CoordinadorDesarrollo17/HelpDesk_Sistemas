@using HelpDesk_Sistemas.Models
@model LoginModel

@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_AuthLayout";
}

<div class="login-page">

    <!-- Fondos decorativos -->
    <div class="auth-blob auth-blob-1"></div>
    <div class="auth-blob auth-blob-2"></div>

    <!-- Tarjeta de login -->
    <div class="auth-card">

        <!-- Línea superior -->
        <div class="auth-card-accent"></div>

        <!-- Branding -->
        <div class="auth-brand">

            <span class="sidebar-brand-mark auth-brand-mark">
                <img src="~/img/logo.png"
                     alt="Logo"
                     onerror="this.style.display='none'" />
            </span>

            <div>
                <div class="auth-brand-title">
                    HelpDesk
                </div>

                <div class="auth-brand-sub">
                    Droguería Cobefar SAC
                </div>
            </div>

        </div>


        <!-- Bienvenida -->
        <div class="auth-welcome">

            <h1>Bienvenido</h1>

            <p>
                Ingresa tus credenciales para continuar
            </p>

        </div>


        <!-- Formulario -->
        <form method="post"
              asp-controller="Auth"
              asp-action="Login"
              id="loginForm">

            <input type="hidden" asp-for="ReturnUrl" />


            <!-- Validaciones -->
            <div asp-validation-summary="All"
                 class="text-danger small login-validation">
            </div>


            <!-- Usuario -->
            <div class="login-field">

                <label asp-for="Usuario">
                    Usuario
                </label>

                <div class="input-group login-input-group">

                    <span class="input-group-text">
                        <i class="bi bi-person"></i>
                    </span>

                    <input asp-for="Usuario"
                           class="form-control"
                           placeholder="Usuario"
                           autocomplete="username"
                           autofocus />

                </div>

                <span asp-validation-for="Usuario"
                      class="text-danger small">
                </span>

            </div>


            <!-- Contraseña -->
            <div class="login-field">

                <label asp-for="Password">
                    Contraseña
                </label>

                <div class="input-group login-input-group">

                    <span class="input-group-text">
                        <i class="bi bi-lock"></i>
                    </span>

                    <input asp-for="Password"
                           id="txtPassword"
                           type="password"
                           class="form-control"
                           placeholder="Contraseña"
                           autocomplete="current-password" />

                    <button class="input-group-text password-button"
                            type="button"
                            id="btnMostrarPassword"
                            aria-label="Mostrar contraseña">

                        <i class="bi bi-eye"
                           id="iconoMostrarPassword">
                        </i>

                    </button>

                </div>

                <span asp-validation-for="Password"
                      class="text-danger small">
                </span>

            </div>


            <!-- Botón -->
            <button type="submit"
                    class="btn btn-primary w-100 login-button"
                    id="btnLogin">

                <span id="loginNormal">
                    <i class="bi bi-box-arrow-in-right"></i>
                    Ingresar
                </span>

                <span id="loginLoading"
                      class="d-none">

                    <span class="spinner-border spinner-border-sm me-2"
                          role="status">
                    </span>

                    Ingresando...

                </span>

            </button>

        </form>


        <!-- Footer -->
        <div class="auth-footer">
            Sistema de Gestión de Soporte
        </div>

    </div>

</div>


<style>

    /* =========================================================
           CONTENEDOR
           ========================================================= */

    .login-page {
        width: 100%;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 25px;
        position: relative;
        overflow: hidden;
        box-sizing: border-box;
    }


    /* =========================================================
           FONDO DECORATIVO
           ========================================================= */

    .auth-blob {
        position: absolute;
        border-radius: 50%;
        filter: blur(60px);
        opacity: .30;
        pointer-events: none;
        z-index: 0;
    }


    .auth-blob-1 {
        width: 300px;
        height: 300px;
        top: -120px;
        left: -100px;
        background: radial-gradient( circle, var(--brand-green-400), transparent 70% );
    }


    .auth-blob-2 {
        width: 280px;
        height: 280px;
        bottom: -120px;
        right: -100px;
        background: radial-gradient( circle, var(--brand-green-500), transparent 70% );
    }


    /* =========================================================
           TARJETA
           ========================================================= */

    .auth-card {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 430px;
        padding: 38px 40px 30px;
        background: #fff;
        border-radius: 18px;
        border: 1px solid rgba(0, 0, 0, .05);
        box-shadow: 0 10px 35px rgba(28, 147, 47, .12), 0 4px 12px rgba(0, 0, 0, .05);
        overflow: hidden;
        animation: loginCard .4s cubic-bezier(.16, 1, .3, 1);
    }


    /* =========================================================
           LÍNEA VERDE SUPERIOR
           ========================================================= */

    .auth-card-accent {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 5px;
        background: linear-gradient( 90deg, var(--brand-green-400), var(--brand-green-700) );
    }


    /* =========================================================
           BRANDING
           ========================================================= */

    .auth-brand {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 30px;
    }


    .auth-brand-mark {
        width: 58px;
        height: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        flex-shrink: 0;
        font-size: 1rem;
        font-weight: 700;
        background: linear-gradient( 135deg, var(--brand-green-500), var(--brand-green-700) );
        box-shadow: 0 8px 20px -6px rgba(28, 147, 47, .45);
        overflow: hidden;
    }


        /*
           El logo ocupa todo el contenedor.
           Se mantiene transparente para que se
           vea el fondo verde del contenedor.
        */

        .auth-brand-mark img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            background: transparent;
            padding: 3px;
        }


    .auth-brand-title {
        font-size: 24px;
        font-weight: 700;
        line-height: 1.1;
        letter-spacing: -.2px;
        color: var(--brand-950);
    }


    .auth-brand-sub {
        margin-top: 4px;
        font-size: 13px;
        color: #6b7280;
    }


    /* =========================================================
           BIENVENIDA
           ========================================================= */

    .auth-welcome {
        margin-bottom: 25px;
    }


        .auth-welcome h1 {
            margin: 0 0 6px;
            font-size: 29px;
            font-weight: 700;
            letter-spacing: -.3px;
            color: var(--brand-950);
        }


        .auth-welcome p {
            margin: 0;
            font-size: 15px;
            color: #6b7280;
        }


    /* =========================================================
           CAMPOS
           ========================================================= */

    .login-field {
        margin-bottom: 18px;
    }


        .login-field label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            font-weight: 600;
            color: var(--brand-950);
        }


    .login-input-group {
        height: 52px;
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid rgba(0, 0, 0, .1);
        transition: box-shadow .15s ease;
    }

        .login-input-group:focus-within {
            border-color: var(--brand-green-500);
            border-radius: 10px;
            box-shadow: 0 0 0 3px var(--brand-green-50);
        }

        .login-input-group .input-group-text,
        .login-input-group .form-control {
            border: none;
        }

            .login-input-group .form-control:focus {
                box-shadow: none;
            }

        .login-input-group .input-group-text {
            background: #fbfbfb;
            color: #6b7280;
        }

        .login-input-group:focus-within .input-group-text {
            background: var(--brand-green-50);
            color: var(--brand-green-700);
        }


    /* =========================================================
           PASSWORD
           ========================================================= */

    .password-button {
        cursor: pointer;
        background: #fbfbfb;
        border-color: rgba(0, 0, 0, .1);
        color: #6b7280;
        transition: color .15s ease, background .15s ease;
    }


        .password-button:hover {
            color: var(--brand-green-700);
            background: var(--brand-green-50);
        }


    /* =========================================================
           VALIDACIÓN
           ========================================================= */

    .login-validation {
        margin-bottom: 18px;
    }


        .login-validation:empty {
            display: none;
        }


    /* =========================================================
           BOTÓN
           ========================================================= */

    .login-button {
        height: 52px;
        margin-top: 6px;
        border-radius: 10px;
        font-size: 15px;
        font-weight: 600;
        letter-spacing: .2px;
        background: linear-gradient( 135deg, var(--brand-green-600), var(--brand-green-700) );
        border: none;
        transition: transform .15s ease, box-shadow .15s ease, filter .15s ease;
    }


        .login-button:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 22px -6px rgba(28, 147, 47, .45);
            filter: brightness(1.03);
        }


        .login-button:active {
            transform: translateY(0);
        }


        .login-button:disabled {
            cursor: not-allowed;
            opacity: .8;
        }


    /* =========================================================
           FOOTER
           ========================================================= */

    .auth-footer {
        margin-top: 22px;
        padding-top: 16px;
        border-top: 1px solid rgba(0, 0, 0, .06);
        text-align: center;
        font-size: 11px;
        letter-spacing: .3px;
        text-transform: uppercase;
        color: #6b7280;
        opacity: .65;
    }


    /* =========================================================
           ANIMACIÓN
           ========================================================= */

    @@keyframes loginCard {

        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 480px) {

        .login-page {
            padding: 15px;
        }


        .auth-card {
            max-width: 100%;
            padding: 30px 24px 25px;
            border-radius: 14px;
        }


        .auth-brand {
            margin-bottom: 26px;
        }


        .auth-brand-mark {
            width: 52px;
            height: 52px;
            border-radius: 13px;
        }


        .auth-brand-title {
            font-size: 21px;
        }


        .auth-welcome h1 {
            font-size: 25px;
        }


        .auth-welcome p {
            font-size: 14px;
        }
    }

</style>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const passwordInput =
                    document.getElementById(
                        "txtPassword"
                    );

                const passwordButton =
                    document.getElementById(
                        "btnMostrarPassword"
                    );

                const passwordIcon =
                    document.getElementById(
                        "iconoMostrarPassword"
                    );

                const loginForm =
                    document.getElementById(
                        "loginForm"
                    );

                const loginButton =
                    document.getElementById(
                        "btnLogin"
                    );

                const loginNormal =
                    document.getElementById(
                        "loginNormal"
                    );

                const loginLoading =
                    document.getElementById(
                        "loginLoading"
                    );


                /* =========================================
                   MOSTRAR / OCULTAR CONTRASEÑA
                   ========================================= */

                passwordButton.addEventListener(
                    "click",
                    function () {

                        const mostrar =
                            passwordInput.type === "password";

                        passwordInput.type =
                            mostrar
                                ? "text"
                                : "password";

                        passwordIcon.className =
                            mostrar
                                ? "bi bi-eye-slash"
                                : "bi bi-eye";

                        passwordButton.setAttribute(
                            "aria-label",
                            mostrar
                                ? "Ocultar contraseña"
                                : "Mostrar contraseña"
                        );

                    }
                );


                /* =========================================
                   ESTADO DE CARGA
                   ========================================= */

                loginForm.addEventListener(
                    "submit",
                    function () {

                        if (!loginForm.checkValidity()) {
                            return;
                        }

                        loginButton.disabled = true;

                        loginNormal.classList.add(
                            "d-none"
                        );

                        loginLoading.classList.remove(
                            "d-none"
                        );

                    }
                );

            }
        );

    </script>

}