@using HelpDesk_Sistemas.Models
@model SlaDashboardModel

@{
    ViewData["Title"] = "Cumplimiento de SLA";
}

@functions {
    string BarraClass(decimal porcentaje) => porcentaje >= 90 ? "bg-success" : porcentaje >= 70 ? "bg-warning" : "bg-danger";
}

<div class="card shadow-sm mb-4">
    <div class="card-header header-gradient text-black d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold">Cumplimiento de SLA</h5>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary btn-sm" asp-controller="Sla" asp-action="Index">
                <i class="bi bi-list-check"></i> Definiciones
            </a>
            <a class="btn btn-outline-secondary btn-sm" asp-controller="Sla" asp-action="Calendario">
                <i class="bi bi-calendar-week"></i> Calendario laboral
            </a>
        </div>
    </div>

    <div class="card-body">
        <!-- KPIs: además de informar, funcionan como filtro de la tabla de abajo -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="border rounded p-3 text-center h-100">
                    <div class="fs-3 fw-bold">@Model.Resumen.PorcentajeCumplimiento%</div>
                    <div class="text-muted small">Cumplimiento histórico</div>
                    <div class="text-muted small">(@Model.Resumen.CumplidosATiempo de @Model.Resumen.TotalCompletados completados)</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <button type="button" class="border rounded p-3 text-center h-100 w-100 btn-filtro-kpi" data-categoria="en-riesgo" onclick="filtrarPorCategoria('en-riesgo')">
                    <div class="fs-3 fw-bold text-warning">@Model.Resumen.EnRiesgo</div>
                    <div class="text-muted small">En riesgo</div>
                    <div class="text-muted small">SLA activo, por vencer</div>
                </button>
            </div>
            <div class="col-6 col-md-3">
                <button type="button" class="border rounded p-3 text-center h-100 w-100 btn-filtro-kpi" data-categoria="incumplido-activo" onclick="filtrarPorCategoria('incumplido-activo')">
                    <div class="fs-3 fw-bold text-danger">@Model.Resumen.IncumplidosEnCurso</div>
                    <div class="text-muted small">Incumplidos activos</div>
                    <div class="text-muted small">SLA vencido, ticket en curso</div>
                </button>
            </div>
            <div class="col-6 col-md-3">
                <button type="button" class="border rounded p-3 text-center h-100 w-100 btn-filtro-kpi" data-categoria="incumplido-finalizado" onclick="filtrarPorCategoria('incumplido-finalizado')">
                    <div class="fs-3 fw-bold text-danger">@Model.Resumen.IncumplidosCompletados</div>
                    <div class="text-muted small">Incumplidos finalizados</div>
                    <div class="text-muted small">SLA vencido, ya finalizado</div>
                </button>
            </div>
        </div>

        <div class="row g-4">
            <!-- Por prioridad -->
            <div class="col-12 col-lg-6">
                <h6 class="fw-bold">Cumplimiento por prioridad</h6>
                @if (Model.PorPrioridad.Count == 0)
                {
                    <p class="text-muted small">Todavía no hay SLA completados.</p>
                }
                else
                {
                    @foreach (var g in Model.PorPrioridad)
                    {
                        <div class="mb-2">
                            <div class="d-flex justify-content-between">
                                <span>@g.Grupo</span>
                                <small class="text-muted">@g.CumplidosATiempo/@g.Completados (@g.PorcentajeCumplimiento%)</small>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar @BarraClass(g.PorcentajeCumplimiento)" style="width: @g.PorcentajeCumplimiento%;"></div>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- Por agente -->
            <div class="col-12 col-lg-6">
                <h6 class="fw-bold">Cumplimiento por agente</h6>
                @if (Model.PorAgente.Count == 0)
                {
                    <p class="text-muted small">Todavía no hay SLA completados con agente asignado.</p>
                }
                else
                {
                    @foreach (var g in Model.PorAgente)
                    {
                        <div class="mb-2">
                            <div class="d-flex justify-content-between">
                                <span>@g.Grupo</span>
                                <small class="text-muted">@g.CumplidosATiempo/@g.Completados (@g.PorcentajeCumplimiento%)</small>
                            </div>
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar @BarraClass(g.PorcentajeCumplimiento)" style="width: @g.PorcentajeCumplimiento%;"></div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <hr />

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
            <h6 class="fw-bold mb-0">Tickets en riesgo o incumplidos</h6>
            <button type="button" class="btn btn-sm btn-outline-secondary d-none" id="btnQuitarFiltro" onclick="filtrarPorCategoria(null)">
                <i class="bi bi-x-lg"></i> Quitar filtro
            </button>
        </div>
        @if (Model.EnRiesgoOIncumplidos.Count == 0)
        {
            <p class="text-muted small">No hay ningún SLA en riesgo ni incumplido en este momento.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle" id="tablaEnRiesgo">
                    <thead>
                        <tr>
                            <th>Ticket</th>
                            <th>SLA</th>
                            <th>Estado</th>
                            <th>Prioridad</th>
                            <th>Asignado</th>
                            <th>Vence</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.EnRiesgoOIncumplidos)
                        {
                            <tr data-categoria="@r.Categoria">
                                <td>@r.CodigoTicket</td>
                                <td>@r.TipoSla</td>
                                <td>@r.Estado</td>
                                <td>@(r.Prioridad ?? "-")</td>
                                <td>@(r.Asignado ?? "-")</td>
                                <td>@r.FechaObjetivo.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (r.Categoria == "incumplido-finalizado")
                                    {
                                        <span class="badge bg-dark">Incumplido finalizado</span>
                                    }
                                    else if (r.Incumplido)
                                    {
                                        <span class="badge bg-danger">Incumplido activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">En riesgo</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p class="text-muted small d-none" id="sinResultadosFiltro">No hay tickets en esta categoría.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Las tarjetas KPI (En riesgo / Incumplidos activos / Incumplidos finalizados)
        // funcionan como filtro de la tabla de abajo, sin ir al servidor: los datos
        // ya están todos cargados en la página.
        // se puede replicar esta funcion
        function filtrarPorCategoria(categoria) {
            const filas = document.querySelectorAll("#tablaEnRiesgo tbody tr");
            let visibles = 0;

            filas.forEach(fila => {
                const coincide = !categoria || fila.dataset.categoria === categoria;
                fila.classList.toggle("d-none", !coincide);
                if (coincide) visibles++;
            });

            document.getElementById("sinResultadosFiltro")?.classList.toggle("d-none", visibles > 0);
            document.getElementById("btnQuitarFiltro")?.classList.toggle("d-none", !categoria);

            document.querySelectorAll(".btn-filtro-kpi").forEach(btn => {
                btn.classList.toggle("kpi-activo", btn.dataset.categoria === categoria);
            });
        }

        // Si se llega aquí desde una tarjeta de Home (?categoria=en-riesgo, etc.),
        // aplica ese filtro solo y lleva la vista directo a la tabla.
        (function aplicarFiltroDesdeUrl() {
            const categoria = new URLSearchParams(window.location.search).get("categoria");
            if (!categoria) return;

            filtrarPorCategoria(categoria);
            document.getElementById("tablaEnRiesgo")?.scrollIntoView({ behavior: "smooth", block: "center" });
        })();
    </script>
}
