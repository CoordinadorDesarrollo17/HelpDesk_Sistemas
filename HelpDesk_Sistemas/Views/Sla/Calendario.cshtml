@using HelpDesk_Sistemas.Models
@model SlaCalendarioModel?

@{
    ViewData["Title"] = "Calendario laboral";
    var calendarios = (List<CatalogoModel>)ViewBag.Calendarios;
    var idSeleccionado = (int?)ViewBag.IdCalendarioSeleccionado;
    var nombresDias = new[] { "Domingo", "Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado" };

    // Orden de semana laboral (Lunes -> Domingo) en vez del orden crudo de Dia_Semana (1=Domingo).
    var ordenDias = new[] { 2, 3, 4, 5, 6, 7, 1 };
}

<style>
    .horario-semanal tr > td {
        border-top: 1px solid rgba(0, 0, 0, .06);
    }

    .franja-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: var(--brand-green-50);
        color: var(--brand-green-700);
        border: 1px solid rgba(28, 147, 47, .18);
        border-radius: 999px;
        padding: 4px 4px 4px 12px;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
    }

    .btn-franja-accion {
        border: none;
        background: transparent;
        color: inherit;
        opacity: .5;
        width: 20px;
        height: 20px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        cursor: pointer;
        font-size: 11px;
        padding: 0;
        transition: opacity .15s ease, background .15s ease;
    }

        .btn-franja-accion:hover {
            opacity: 1;
            background: rgba(0, 0, 0, .08);
        }

        .btn-franja-accion.btn-franja-eliminar:hover {
            color: var(--bs-danger);
        }
</style>

<div class="card shadow-sm mb-4">
    <div class="card-header header-gradient text-black d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold">Calendario laboral</h5>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary btn-sm" asp-controller="Sla" asp-action="Dashboard">
                <i class="bi bi-graph-up"></i> Cumplimiento
            </a>
            <a class="btn btn-outline-secondary btn-sm" asp-controller="Sla" asp-action="Index">
                <i class="bi bi-arrow-left"></i> Definiciones de SLA
            </a>
        </div>
    </div>

    <div class="card-body">
        <div class="row g-4">
            <div class="col-12 col-md-4">
                <label class="form-label fw-semibold">Calendario</label>
                <select id="cboCalendario" class="form-select mb-2">
                    @foreach (var cal in calendarios)
                    {
                        <option value="@cal.Id" selected="@(cal.Id == idSeleccionado)">@cal.Nombre</option>
                    }
                </select>

                <div class="input-group input-group-sm">
                    <input type="text" id="txtNuevoCalendario" class="form-control" placeholder="Nombre del nuevo calendario" />
                    <button class="btn btn-outline-primary" onclick="crearCalendario()"><i class="bi bi-plus-lg"></i></button>
                </div>
            </div>

            <div class="col-12 col-md-8">
                @if (Model is null)
                {
                    <p class="text-muted">Crea un calendario laboral para empezar.</p>
                }
                else
                {
                    <h6 class="fw-bold">Horario semanal</h6>
                    <table class="table table-sm align-middle horario-semanal">
                        <thead><tr><th style="width:120px">Día</th><th>Franjas horarias</th><th style="width:56px"></th></tr></thead>
                        <tbody>
                            @{
                                var horariosPorDia = Model.Horarios.ToLookup(h => h.DiaSemana);
                            }
                            @foreach (var dia in ordenDias)
                            {
                                var franjas = horariosPorDia[dia].OrderBy(h => h.HoraInicio).ToList();
                                <tr>
                                    <td class="fw-semibold">@nombresDias[dia - 1]</td>
                                    <td>
                                        @if (franjas.Count == 0)
                                        {
                                            <span class="text-muted small fst-italic">No laborable</span>
                                        }
                                        else
                                        {
                                            <div class="d-flex flex-wrap gap-2">
                                                @foreach (var h in franjas)
                                                {
                                                    <span class="franja-badge">
                                                        @h.HoraInicio.ToString(@"hh\:mm")&nbsp;–&nbsp;@h.HoraFin.ToString(@"hh\:mm")
                                                        <button type="button" class="btn-franja-accion" title="Editar franja"
                                                                onclick="editarHorario(@h.Id, @dia, '@h.HoraInicio.ToString(@"hh\:mm")', '@h.HoraFin.ToString(@"hh\:mm")')">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                        <button type="button" class="btn-franja-accion btn-franja-eliminar" title="Eliminar franja"
                                                                onclick="eliminarHorario(@h.Id)">
                                                            <i class="bi bi-x-lg"></i>
                                                        </button>
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-outline-primary" title="Agregar franja a @nombresDias[dia - 1]"
                                                onclick="agregarFranjaRapida(@dia)">
                                            <i class="bi bi-plus-lg"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <input type="hidden" id="idHorarioEditando" value="" />
                    <div class="d-flex gap-2 align-items-end flex-wrap mb-4">
                        <div>
                            <label class="form-label small mb-0">Día</label>
                            <select id="selDiaSemana" class="form-select form-select-sm">
                                @for (var i = 0; i < nombresDias.Length; i++)
                                {
                                    <option value="@(i + 1)">@nombresDias[i]</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="form-label small mb-0">Inicio</label>
                            <input type="time" id="txtHoraInicio" class="form-control form-control-sm" value="08:00" />
                        </div>
                        <div>
                            <label class="form-label small mb-0">Fin</label>
                            <input type="time" id="txtHoraFin" class="form-control form-control-sm" value="18:00" />
                        </div>
                        <button class="btn btn-sm btn-outline-primary" id="btnGuardarHorario" onclick="guardarHorario()">Agregar franja</button>
                        <button class="btn btn-sm btn-link d-none" id="btnCancelarHorario" onclick="cancelarEdicionHorario()">Cancelar</button>
                    </div>

                    <h6 class="fw-bold">Feriados</h6>
                    <table class="table table-sm align-middle">
                        <thead><tr><th>Fecha</th><th>Descripción</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var f in Model.Feriados)
                            {
                                <tr>
                                    <td>@f.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td>@f.Descripcion</td>
                                    <td class="text-end text-nowrap">
                                        <button class="btn btn-sm btn-outline-secondary" title="Editar"
                                                data-id="@f.Id" data-fecha="@f.Fecha.ToString("yyyy-MM-dd")" data-descripcion="@f.Descripcion"
                                                onclick="editarFeriado(this.dataset.id, this.dataset.fecha, this.dataset.descripcion)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" title="Eliminar" onclick="eliminarFeriado(@f.Id)"><i class="bi bi-trash"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <input type="hidden" id="idFeriadoEditando" value="" />
                    <div class="d-flex gap-2 align-items-end flex-wrap">
                        <div>
                            <label class="form-label small mb-0">Fecha</label>
                            <input type="date" id="txtFechaFeriado" class="form-control form-control-sm" />
                        </div>
                        <div class="flex-grow-1">
                            <label class="form-label small mb-0">Descripción</label>
                            <input type="text" id="txtDescripcionFeriado" class="form-control form-control-sm" placeholder="Ej. Fiestas Patrias" />
                        </div>
                        <button class="btn btn-sm btn-outline-primary" id="btnGuardarFeriado" onclick="guardarFeriado()">Agregar feriado</button>
                        <button class="btn btn-sm btn-link d-none" id="btnCancelarFeriado" onclick="cancelarEdicionFeriado()">Cancelar</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
    <div id="toastGenerico" class="toast align-items-center border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body" id="toastMensaje"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function fetchConManejo(url, opciones) {
            return fetch(url, opciones).catch(error => {
                console.error(error);
                mostrarToast("No se pudo conectar con el servidor. Revisa tu conexión.", "danger");
                return null;
            });
        }

        function mostrarToast(mensaje, tipo = "danger") {
            const toastEl = document.getElementById("toastGenerico");
            const toastMensaje = document.getElementById("toastMensaje");
            toastEl.classList.remove("text-bg-success", "text-bg-danger", "text-bg-warning");
            toastEl.classList.add(`text-bg-${tipo}`);
            toastMensaje.textContent = mensaje;
            new bootstrap.Toast(toastEl, { delay: 4000 }).show();
        }

        document.getElementById("cboCalendario").addEventListener("change", function () {
            window.location.href = `@Url.Action("Calendario")?id=${this.value}`;
        });

        function crearCalendario() {
            const nombre = document.getElementById("txtNuevoCalendario").value;
            if (!nombre.trim()) {
                mostrarToast("Indica un nombre para el calendario.", "danger");
                return;
            }

            fetchConManejo(`@Url.Action("CrearCalendario")?nombre=${encodeURIComponent(nombre)}`, { method: "POST" })
                .then(r => r && r.json())
                .then(data => {
                    if (!data) return;
                    if (data.exito) {
                        window.location.href = `@Url.Action("Calendario")?id=${data.idCalendario}`;
                    } else {
                        mostrarToast(data.mensaje || "No se pudo crear el calendario.", "danger");
                    }
                });
        }

        function editarHorario(id, diaSemana, horaInicio, horaFin) {
            document.getElementById("idHorarioEditando").value = id;
            document.getElementById("selDiaSemana").value = diaSemana;
            document.getElementById("txtHoraInicio").value = horaInicio;
            document.getElementById("txtHoraFin").value = horaFin;
            document.getElementById("btnGuardarHorario").textContent = "Guardar cambios";
            document.getElementById("btnCancelarHorario").classList.remove("d-none");
        }

        function agregarFranjaRapida(diaSemana) {
            cancelarEdicionHorario();
            document.getElementById("selDiaSemana").value = diaSemana;
            document.getElementById("txtHoraInicio").scrollIntoView({ behavior: "smooth", block: "center" });
            document.getElementById("txtHoraInicio").focus();
        }

        function cancelarEdicionHorario() {
            document.getElementById("idHorarioEditando").value = "";
            document.getElementById("selDiaSemana").value = "2";
            document.getElementById("txtHoraInicio").value = "08:00";
            document.getElementById("txtHoraFin").value = "18:00";
            document.getElementById("btnGuardarHorario").textContent = "Agregar franja";
            document.getElementById("btnCancelarHorario").classList.add("d-none");
        }

        function guardarHorario() {
            const idEditando = document.getElementById("idHorarioEditando").value;
            const idCalendario = document.getElementById("cboCalendario").value;
            const diaSemana = document.getElementById("selDiaSemana").value;
            const horaInicio = document.getElementById("txtHoraInicio").value;
            const horaFin = document.getElementById("txtHoraFin").value;

            const params = new URLSearchParams({ idCalendario, diaSemana, horaInicio, horaFin });
            if (idEditando) params.set("id", idEditando);

            const url = idEditando ? `@Url.Action("ActualizarHorario")` : `@Url.Action("AgregarHorario")`;

            fetchConManejo(`${url}?${params.toString()}`, { method: "POST" })
                .then(r => r && r.json())
                .then(data => {
                    if (!data) return;
                    if (data.exito) {
                        window.location.reload();
                    } else {
                        mostrarToast(data.mensaje || "No se pudo guardar el horario.", "danger");
                    }
                });
        }

        function eliminarHorario(id) {
            fetchConManejo(`@Url.Action("EliminarHorario")?id=${id}`, { method: "POST" })
                .then(r => r && r.json())
                .then(data => { if (data) window.location.reload(); });
        }

        function editarFeriado(id, fecha, descripcion) {
            document.getElementById("idFeriadoEditando").value = id;
            document.getElementById("txtFechaFeriado").value = fecha;
            document.getElementById("txtDescripcionFeriado").value = descripcion;
            document.getElementById("btnGuardarFeriado").textContent = "Guardar cambios";
            document.getElementById("btnCancelarFeriado").classList.remove("d-none");
        }

        function cancelarEdicionFeriado() {
            document.getElementById("idFeriadoEditando").value = "";
            document.getElementById("txtFechaFeriado").value = "";
            document.getElementById("txtDescripcionFeriado").value = "";
            document.getElementById("btnGuardarFeriado").textContent = "Agregar feriado";
            document.getElementById("btnCancelarFeriado").classList.add("d-none");
        }

        function guardarFeriado() {
            const idEditando = document.getElementById("idFeriadoEditando").value;
            const idCalendario = document.getElementById("cboCalendario").value;
            const fecha = document.getElementById("txtFechaFeriado").value;
            const descripcion = document.getElementById("txtDescripcionFeriado").value;

            if (!fecha) {
                mostrarToast("Selecciona una fecha.", "danger");
                return;
            }

            const params = new URLSearchParams({ idCalendario, fecha, descripcion: descripcion || "" });
            if (idEditando) params.set("id", idEditando);

            const url = idEditando ? `@Url.Action("ActualizarFeriado")` : `@Url.Action("AgregarFeriado")`;

            fetchConManejo(`${url}?${params.toString()}`, { method: "POST" })
                .then(r => r && r.json())
                .then(data => {
                    if (!data) return;
                    if (data.exito) {
                        window.location.reload();
                    } else {
                        mostrarToast(data.mensaje || "No se pudo guardar el feriado.", "danger");
                    }
                });
        }

        function eliminarFeriado(id) {
            fetchConManejo(`@Url.Action("EliminarFeriado")?id=${id}`, { method: "POST" })
                .then(r => r && r.json())
                .then(data => { if (data) window.location.reload(); });
        }
    </script>
}
