@using HelpDesk_Sistemas.Models
@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="card shadow-sm mb-4">
    <div class="card-header header-gradient text-black">
        <h5 class="mb-0 fw-bold">Ocurrió un error</h5>
    </div>
    <div class="card-body">
        <p>No se pudo completar tu solicitud. Intenta nuevamente o contacta a soporte si el problema continúa.</p>

        @if (Model.ShowRequestId)
        {
            <p class="text-muted small">
                Id de referencia: <code>@Model.RequestId</code>
            </p>
        }

        <a class="btn btn-primary btn-sm" asp-controller="Home" asp-action="Index">
            <i class="bi bi-house"></i> Volver al inicio
        </a>
    </div>
</div>
