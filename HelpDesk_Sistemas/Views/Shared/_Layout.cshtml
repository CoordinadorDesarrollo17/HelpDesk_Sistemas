<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HelpDesk_Sistemas</title>
    <script>
        // Se aplica antes de pintar la página (evita el parpadeo del tema
        // incorrecto). Usa la preferencia guardada, o si no hay ninguna, la
        // del sistema operativo.
        (function () {
            var tema = localStorage.getItem("tema") || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
            document.documentElement.setAttribute("data-bs-theme", tema);
        })();
    </script>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HelpDesk_Sistemas.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.css" asp-append-version="true">
    <link rel="stylesheet" href="~/lib/sweetalert2/sweetalert2.min.css" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    @RenderSection("Styles", required: false)
</head>
<body>
    @{
        var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString();
        var accionActual = ViewContext.RouteData.Values["action"]?.ToString();
    }
    <div class="app-shell">
        @{
            var esAdministrador = User.IsInRole("Administrador");
            var esSoporte = User.IsInRole("Soporte");

        }
        <aside class="sidebar" id="sidebar">
            <a class="sidebar-brand" asp-area="" asp-controller="@(esAdministrador ? "Home" : "Tickets")" asp-action="@(esAdministrador ? "Index" : "ListadoTickets")">
                <span class="sidebar-brand-mark">
                    <img src="~/img/logo.png" alt="Logo" onerror="this.style.display='none'" />
                </span>
                <span class="sidebar-brand-text">HelpDesk<small>Cobefar</small></span>
            </a>

            <nav class="sidebar-nav">
                @if (esAdministrador)
                {
                    <a class="sidebar-link @(controladorActual == "Home" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door"></i> <span>Home</span>
                    </a>
                }
                <a class="sidebar-link @(controladorActual == "Tickets" ? "active" : "")" asp-area="" asp-controller="Tickets" asp-action="ListadoTickets">
                    <i class="bi bi-ticket-perforated"></i> <span>Tickets</span>
                </a>

                @if (esAdministrador)
                {
                    <a class="sidebar-link @(controladorActual == "Reportes" ? "active" : "")" asp-area="" asp-controller="Reportes" asp-action="Index">
                        <i class="bi bi-bar-chart-line"></i> <span>Reportes</span>
                    </a>

                    <div class="sidebar-section-label">SLA</div>
                    <a class="sidebar-link sidebar-link-sub @(controladorActual == "Sla" && accionActual == "Index" ? "active" : "")" asp-area="" asp-controller="Sla" asp-action="Index">
                        <i class="bi bi-list-check"></i> <span>Definiciones</span>
                    </a>
                    <a class="sidebar-link sidebar-link-sub @(controladorActual == "Sla" && accionActual == "Calendario" ? "active" : "")" asp-area="" asp-controller="Sla" asp-action="Calendario">
                        <i class="bi bi-calendar-week"></i> <span>Calendario laboral</span>
                    </a>
                    <a class="sidebar-link sidebar-link-sub @(controladorActual == "Sla" && accionActual == "Dashboard" ? "active" : "")" asp-area="" asp-controller="Sla" asp-action="Dashboard">
                        <i class="bi bi-graph-up"></i> <span>Cumplimiento</span>
                    </a>
                }
                @if (esAdministrador || esSoporte)
                {
                    <div class="sidebar-section-label">Administración</div>

                    <a class="sidebar-link @(controladorActual == "Usuarios" ? "active" : "")"
                       asp-area=""
                       asp-controller="Usuarios"
                       asp-action="Index">
                        <i class="bi bi-people"></i> <span>Usuarios</span>
                    </a>
                }
            </nav>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="sidebar-user">
                    <div class="sidebar-user-info">
                        <div class="sidebar-user-nombre">@HelpDesk_Sistemas.Common.SesionTemporal.NombreCompletoActual</div>
                        <div class="sidebar-user-rol">@HelpDesk_Sistemas.Common.SesionTemporal.RolActual</div>
                    </div>
                    <div class="d-flex gap-1">
                        <button type="button" class="btn btn-sm btn-outline-light" id="btnToggleTema" title="Cambiar tema">
                            <i class="bi bi-moon-stars" id="iconoTema"></i>
                        </button>
                        <form method="post" asp-controller="Auth" asp-action="Logout">
                            <button type="submit" class="btn btn-sm btn-outline-light" title="Cerrar sesión">
                                <i class="bi bi-box-arrow-right"></i>
                            </button>
                        </form>
                    </div>
                </div>
            }
        </aside>

        <div class="app-main">
            <header class="app-topbar d-md-none">
                <button class="btn btn-sm btn-outline-secondary" type="button" id="btnToggleSidebar" aria-label="Abrir menú">
                    <i class="bi bi-list"></i>
                </button>
                <span class="app-topbar-brand">HelpDesk_Sistemas</span>
            </header>

            <main class="app-content" role="main">
                @RenderBody()
            </main>

            <footer class="app-footer">
                &copy; 2026 - HelpDesk_Sistemas
            </footer>
        </div>
    </div>

    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
     <script src="~/lib/sweetalert2/sweetalert2.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
